---
/**
 * Accordion.astro — FAQ / Accordéon Premium UI/UX Pro Max.
 */

interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: extraClass = "" } = Astro.props;
---

<div class={`topo-accordion ${extraClass}`.trim()}>
  {items.map((item, idx) => (
    <div class="topo-accordion__item" id={`acc-item-${idx}`}>
      <button
        type="button"
        class="topo-accordion__button"
        id={`acc-btn-${idx}`}
        aria-expanded="false"
        aria-controls={`acc-panel-${idx}`}
      >
        <span class="topo-accordion__question">
          <span class="topo-accordion__q-badge">Q</span>
          {item.q}
        </span>
        <div class="topo-accordion__icon-wrapper">
          <svg class="topo-accordion__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </button>

      <div
        id={`acc-panel-${idx}`}
        class="topo-accordion__panel"
        role="region"
        aria-labelledby={`acc-btn-${idx}`}
        style="display: none;"
      >
        <div class="topo-accordion__content">
          <p>{item.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
.topo-accordion {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
  max-width: 860px;
  margin-inline: auto;
}

.topo-accordion__item {
  background: rgba(18, 24, 38, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.topo-accordion__item:hover {
  border-color: rgba(255, 107, 0, 0.3);
  background: rgba(22, 30, 48, 0.85);
  box-shadow: 0 6px 24px rgba(255, 107, 0, 0.08);
}

.topo-accordion__item.is-open {
  border-color: rgba(255, 107, 0, 0.6);
  background: rgba(24, 33, 52, 0.95);
  box-shadow: 0 8px 32px rgba(255, 107, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.topo-accordion__button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  padding: 20px 24px;
  text-align: left;
  font-family: var(--font-sans, system-ui, sans-serif);
  font-size: 1.05rem;
  font-weight: 600;
  color: #F1F5F9;
  background: transparent;
  border: none;
  cursor: pointer;
  transition: color 0.2s ease;
  user-select: none;
}

.topo-accordion__button:hover {
  color: #FFFFFF;
}

.topo-accordion__question {
  display: flex;
  align-items: center;
  gap: 14px;
  line-height: 1.4;
}

.topo-accordion__q-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: rgba(255, 107, 0, 0.15);
  border: 1px solid rgba(255, 107, 0, 0.3);
  color: #FF6B00;
  font-family: var(--font-mono, monospace);
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.topo-accordion__item.is-open .topo-accordion__q-badge {
  background: #FF6B00;
  color: #FFFFFF;
  border-color: #FF6B00;
  box-shadow: 0 0 12px rgba(255, 107, 0, 0.4);
}

.topo-accordion__icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #94A3B8;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.topo-accordion__button:hover .topo-accordion__icon-wrapper {
  background: rgba(255, 107, 0, 0.15);
  color: #FF6B00;
  border-color: rgba(255, 107, 0, 0.4);
}

.topo-accordion__item.is-open .topo-accordion__icon-wrapper {
  background: rgba(255, 107, 0, 0.2);
  color: #FF6B00;
  border-color: rgba(255, 107, 0, 0.5);
  transform: rotate(180deg);
}

.topo-accordion__panel {
  padding: 0 24px 22px 66px;
}

.topo-accordion__content {
  font-size: 0.98rem;
  color: #CBD5E1;
  line-height: 1.7;
  border-top: 1px dashed rgba(255, 255, 255, 0.08);
  padding-top: 16px;
}

.topo-accordion__content p {
  margin: 0;
}

@media (max-width: 640px) {
  .topo-accordion__button {
    padding: 16px 18px;
    font-size: 0.95rem;
  }
  .topo-accordion__panel {
    padding: 0 18px 18px 18px;
  }
  .topo-accordion__q-badge {
    width: 24px;
    height: 24px;
    font-size: 11px;
  }
}
</style>

<script>
function setupAccordions() {
  const items = document.querySelectorAll(".topo-accordion__item");

  items.forEach((item) => {
    const btn = item.querySelector(".topo-accordion__button");
    const panel = item.querySelector(".topo-accordion__panel") as HTMLElement | null;

    if (!btn || !panel) return;
    if (btn.hasAttribute("data-ready")) return;
    btn.setAttribute("data-ready", "true");

    btn.addEventListener("click", () => {
      const isOpen = item.classList.contains("is-open");

      // Fermer tous les autres accordéons
      items.forEach((otherItem) => {
        if (otherItem !== item) {
          otherItem.classList.remove("is-open");
          const otherBtn = otherItem.querySelector(".topo-accordion__button");
          const otherPanel = otherItem.querySelector(".topo-accordion__panel") as HTMLElement | null;
          if (otherBtn) otherBtn.setAttribute("aria-expanded", "false");
          if (otherPanel) otherPanel.style.display = "none";
        }
      });

      // Basculer l'élément courant
      if (isOpen) {
        item.classList.remove("is-open");
        btn.setAttribute("aria-expanded", "false");
        panel.style.display = "none";
      } else {
        item.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
        panel.style.display = "block";
      }
    });
  });
}

setupAccordions();
document.addEventListener("astro:page-load", setupAccordions);
</script>