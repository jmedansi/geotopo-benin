---
/**
 * Footer.astro — Pied de page Pro Max Dark Luxe.
 */

import { site } from "../config/site";
import { waLink } from "../lib/whatsapp";
import Contours from "./Contours.astro";

const year = new Date().getFullYear();
const waHref = waLink(site.messages.contact);
---

<footer class="site-footer" role="contentinfo">
  <Contours variant="subtle" />

  <div class="container site-footer__inner">

    <!-- Colonne 1 : Marque & Identité -->
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label={`${site.name} — Accueil`}>
        <div class="site-footer__logo-icon">
          <svg width="28" height="28" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <circle cx="18" cy="18" r="15" stroke="currentColor" stroke-width="2" stroke-dasharray="4 2"/>
            <circle cx="18" cy="18" r="9" stroke="var(--color-laser)" stroke-width="1.5"/>
            <circle cx="18" cy="18" r="3" fill="var(--color-accent)"/>
          </svg>
        </div>
        <span class="site-footer__logo-name">{site.name}</span>
      </a>
      <p class="site-footer__tagline">{site.tagline}</p>
      <p class="site-footer__meta">📍 {site.address}</p>
      <p class="site-footer__meta">🕒 {site.hours}</p>
    </div>

    <!-- Colonne 2 : Navigation rapide -->
    <nav class="site-footer__col" aria-label="Navigation footer">
      <p class="site-footer__heading">Navigation</p>
      <ul class="site-footer__list" role="list">
        <li><a href="/">Accueil</a></li>
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/panier">Panier client</a></li>
      </ul>
    </nav>

    <!-- Colonne 3 : Contact & Assistance -->
    <div class="site-footer__col">
      <p class="site-footer__heading">Contact Direct</p>
      <ul class="site-footer__list" role="list">
        <li>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="site-footer__wa-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Assistance WhatsApp
          </a>
        </li>
        <li>
          <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="site-footer__phone">
            📞 {site.phone}
          </a>
        </li>
        <li>
          <a href="/contact">Page contact & itinéraire &rarr;</a>
        </li>
      </ul>
    </div>

  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p class="site-footer__copy">
        &copy; {year} {site.name}. Tous droits réservés.
      </p>

    </div>
  </div>
</footer>

<style>
.site-footer {
  position: relative;
  background-color: #07090E;
  border-top: 1px solid var(--color-border);
  color: var(--color-text-muted);
  overflow: hidden;
  padding-top: var(--space-16);
}

.site-footer__inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  padding-bottom: var(--space-12);
}

@media (min-width: 640px) {
  .site-footer__inner {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .site-footer__inner {
    grid-template-columns: 2fr 1fr 1fr;
  }
}

.site-footer__logo {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
  text-decoration: none;
}

.site-footer__logo-icon {
  color: var(--color-accent);
}

.site-footer__logo-name {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
}

.site-footer__tagline {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-4);
  max-width: 32ch;
}

.site-footer__meta {
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  line-height: 1.8;
}

.site-footer__heading {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: var(--space-4);
}

.site-footer__list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.site-footer__list a {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  transition: color var(--transition-fast);
}

.site-footer__list a:hover {
  color: #FFFFFF;
}

.site-footer__wa-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  color: #25D366 !important;
  font-weight: var(--weight-semibold);
}

.site-footer__wa-btn:hover {
  color: #4ADE80 !important;
}

.site-footer__bottom {
  position: relative;
  z-index: 2;
  border-top: 1px solid var(--color-border);
  padding-block: var(--space-6);
  background-color: rgba(0, 0, 0, 0.4);
}

.site-footer__bottom-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.site-footer__copy,
.site-footer__legal {
  font-size: var(--text-xs);
  color: var(--color-text-faint);
}
</style>
