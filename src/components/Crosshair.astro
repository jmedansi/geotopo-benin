---
/**
 * Crosshair.astro — Réticule topographique qui suit la souris dans les sections sombres.
 * Visible uniquement sur desktop dans les conteneurs munis de data-crosshair.
 */
---

<div id="geotopo-crosshair" class="geotopo-crosshair" aria-hidden="true">
  <!-- Cercle cible -->
  <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
    <circle cx="20" cy="20" r="18" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="4 2"/>
    <line x1="4" y1="20" x2="14" y2="20" stroke="var(--color-accent)" stroke-width="1.5"/>
    <line x1="26" y1="20" x2="36" y2="20" stroke="var(--color-accent)" stroke-width="1.5"/>
    <line x1="20" y1="4" x2="20" y2="14" stroke="var(--color-accent)" stroke-width="1.5"/>
    <line x1="20" y1="26" x2="20" y2="36" stroke="var(--color-accent)" stroke-width="1.5"/>
    <circle cx="20" cy="20" r="2" fill="var(--color-accent)"/>
  </svg>
</div>

<style>
.geotopo-crosshair {
  position: fixed;
  top: -20px;
  left: -20px;
  width: 40px;
  height: 40px;
  pointer-events: none;
  z-index: 9999;
  opacity: 0;
  transform: translate3d(0, 0, 0);
  transition: opacity 0.2s ease;
}

.geotopo-crosshair.is-visible {
  opacity: 0.75;
}

@media (max-width: 767px), (hover: none) {
  .geotopo-crosshair {
    display: none !important;
  }
}
</style>