---
/**
 * ProductCard.astro — Carte produit augmentée (Prompt 1).
 * Image 4/3, Tilt 3D (data-tilt), badges, prix/devis, animation fly-to-cart, toast.
 */

import { Image } from "astro:assets";
import type { ProductEntry } from "../lib/catalog";
import { formatPrice } from "../lib/price";

interface Props {
  product: ProductEntry;
  loading?: "eager" | "lazy";
  class?: string;
}

const { product, loading = "lazy", class: extraClass = "" } = Astro.props;
const { title, cover, availability, leadTime, price, summary } = product.data;
const slug = product.id;
const formattedPrice = formatPrice(price);
const isBoutique = availability === "en-boutique";
---

<article
  class={`product-card ${extraClass}`.trim()}
  data-tilt
  data-reveal="up"
>
  <!-- Image 4/3 avec survol zoom -->
  <div class="product-card__media">
    <Image
      src={cover}
      alt={title}
      width={600}
      height={450}
      loading={loading}
      class="product-card__image"
      data-card-img={slug}
    />
    
    <!-- Badge de disponibilité -->
    <div class="product-card__badge-wrapper">
      {isBoutique ? (
        <span class="badge badge--boutique">
          <span class="badge__dot"></span> En boutique
        </span>
      ) : (
        <span class="badge badge--commande">
          <span class="badge__dot"></span> Sur commande {leadTime ? `(${leadTime})` : ""}
        </span>
      )}
    </div>
  </div>

  <!-- Corps -->
  <div class="product-card__body">
    <h3 class="product-card__title">
      <a href={`/produit/${slug}`} class="product-card__link">
        {title}
      </a>
    </h3>

    <p class="product-card__summary">{summary}</p>

    <!-- Pied de carte -->
    <div class="product-card__footer">
      <div class="product-card__price-wrapper">
        <span class="product-card__price-label">Prix</span>
        <span class={`product-card__price ${price === undefined ? "is-devis" : ""}`}>
          {formattedPrice}
        </span>
      </div>

      <!-- Bouton d'ajout rapide -->
      <div class="product-card__cart-btn">
        <button
          type="button"
          class="btn btn--outline btn--sm product-card__add-btn"
          data-slug={slug}
          data-type="produit"
          aria-label={`Ajouter ${title} au panier`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span>Ajouter</span>
        </button>
      </div>
    </div>
  </div>
</article>

<style>
.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-xs);
  will-change: transform;
  transition:
    box-shadow var(--transition-fast),
    border-color var(--transition-fast);
}

.product-card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--color-border-strong);
}

.product-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background-color: var(--color-surface-alt);
}

.product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.product-card:hover .product-card__image {
  transform: scale(1.05);
}

.product-card__badge-wrapper {
  position: absolute;
  top: var(--space-3);
  left: var(--space-3);
  z-index: 2;
}

.badge__dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: currentColor;
}

.product-card__body {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  padding: var(--space-4);
}

.product-card__title {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  line-height: var(--leading-snug);
  margin-bottom: var(--space-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-card__link {
  color: var(--color-text);
  text-decoration: none;
}

.product-card__link::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
}

.product-card:hover .product-card__link {
  color: var(--color-accent);
}

.product-card__summary {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-4);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex-grow: 1;
}

.product-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-2);
  padding-top: var(--space-3);
  border-top: 1px dashed var(--color-border);
  margin-top: auto;
}

.product-card__price-wrapper {
  display: flex;
  flex-direction: column;
}

.product-card__price-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: var(--tracking-wider);
  color: var(--color-text-faint);
}

.product-card__price {
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
}

.product-card__price.is-devis {
  color: var(--color-text-muted);
  font-style: italic;
  font-weight: var(--weight-semibold);
}

.product-card__cart-btn {
  position: relative;
  z-index: 2;
}
</style>

<script>
import { addToCart } from "../lib/cart";
import { animate } from "motion";

function initProductCardCart() {
  const addBtns = document.querySelectorAll<HTMLButtonElement>(".product-card__add-btn");

  addBtns.forEach((btn) => {
    if (btn.dataset.cardBtnInit) return;
    btn.dataset.cardBtnInit = "true";

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const slug = btn.dataset.slug;
      if (!slug) return;

      const card = btn.closest(".product-card");
      const img = card?.querySelector<HTMLImageElement>(`[data-card-img="${slug}"]`);
      const cartHeader = document.getElementById("header-cart-link");

      // Animation du vol d'image vers le panier
      if (img && cartHeader && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const imgRect = img.getBoundingClientRect();
        const cartRect = cartHeader.getBoundingClientRect();

        const clone = img.cloneNode(true) as HTMLImageElement;
        clone.style.position = "fixed";
        clone.style.left = `${imgRect.left}px`;
        clone.style.top = `${imgRect.top}px`;
        clone.style.width = `${imgRect.width}px`;
        clone.style.height = `${imgRect.height}px`;
        clone.style.zIndex = "99999";
        clone.style.pointerEvents = "none";
        clone.style.borderRadius = "8px";
        document.body.appendChild(clone);

        animate(
          clone,
          {
            left: [`${imgRect.left}px`, `${cartRect.left + 10}px`],
            top: [`${imgRect.top}px`, `${cartRect.top + 10}px`],
            width: [`${imgRect.width}px`, "24px"],
            height: [`${imgRect.height}px`, "24px"],
            opacity: [1, 0.4],
          },
          { duration: 0.6, easing: [0.22, 1, 0.36, 1] }
        ).finished.then(() => {
          clone.remove();

          // Rebond du panier header
          animate(
            cartHeader,
            { transform: ["scale(1)", "scale(1.3)", "scale(1)"] },
            { duration: 0.4 }
          );
        });
      }

      // Ajout effectif dans le panier
      addToCart(slug, "produit", 1);
    });
  });
}

initProductCardCart();
document.addEventListener("astro:page-load", initProductCardCart);
</script>