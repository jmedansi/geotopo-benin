---
/**
 * CategoryCard.astro — Carte catégorie Pro Max Glassmorphic.
 */

import { Image } from "astro:assets";
import type { CategoryEntry } from "../lib/catalog";

interface Props {
  category: CategoryEntry;
  count?: number;
}

const { category, count } = Astro.props;
const { title, description, tagline, cover } = category.data;
const slug = category.id;
---

<a href={`/categorie/${slug}`} class="category-card" data-tilt data-reveal="up">
  {cover && (
    <div class="category-card__media">
      <Image src={cover} alt={title} width={600} height={380} class="category-card__image" />
      <div class="category-card__overlay"></div>
    </div>
  )}

  <div class="category-card__body">
    <div class="category-card__header">
      <span class="category-card__count">{count ?? 3} référence{count && count > 1 ? "s" : "s"}</span>
      {tagline && <span class="category-card__tagline">{tagline}</span>}
    </div>

    <h3 class="category-card__title">{title}</h3>
    <p class="category-card__desc">{description}</p>

    <div class="category-card__footer">
      <span class="category-card__arrow">
        Explorer la gamme
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
.category-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  text-decoration: none;
  color: var(--color-text);
  box-shadow: var(--shadow-sm);
  will-change: transform;
  transition: all var(--transition-base);
}

.category-card:hover {
  border-color: var(--color-accent);
  box-shadow: var(--shadow-glow), var(--shadow-md);
}

.category-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background-color: var(--color-bg-alt);
}

.category-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.category-card:hover .category-card__image {
  transform: scale(1.08);
}

.category-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(11, 14, 20, 0.1) 0%, rgba(11, 14, 20, 0.85) 100%);
}

.category-card__body {
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.category-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.category-card__count {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: var(--weight-bold);
  color: var(--color-laser);
  background-color: rgba(0, 229, 255, 0.1);
  border: 1px solid rgba(0, 229, 255, 0.25);
  padding: 2px 10px;
  border-radius: var(--radius-full);
}

.category-card__tagline {
  font-size: 11px;
  color: var(--color-text-faint);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.category-card__title {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-2);
  transition: color var(--transition-fast);
}

.category-card:hover .category-card__title {
  color: var(--color-accent);
}

.category-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-5);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.category-card__footer {
  margin-top: auto;
  padding-top: var(--space-3);
  border-top: 1px dashed var(--color-border);
}

.category-card__arrow {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-accent);
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  transition: transform var(--transition-fast);
}

.category-card:hover .category-card__arrow {
  transform: translateX(4px);
}
</style>