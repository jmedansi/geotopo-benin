---
/**
 * Gallery.astro — Galerie d'images d'un produit.
 *
 * Image principale 4/3 et bande de vignettes. Toutes les images sont
 * empilées et une seule porte la classe « is-current » : le passage
 * d'une vue à l'autre se fait par fondu, sans rechargement ni cadre
 * vide (ce qu'aurait donné un simple changement de src sur une seule
 * balise <img>).
 *
 * Le zoom passe par Lightbox.astro, un composant séparé. La galerie
 * se contente d'émettre window « lightbox:ouvrir » : les deux ne se
 * connaissent pas.
 *
 * Sans JavaScript, l'image de couverture reste visible — c'est la
 * première balise et la seule marquée « is-current » dans le HTML.
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Lightbox from "./Lightbox.astro";

interface Props {
  /** Image de couverture, affichée par défaut. */
  cover: ImageMetadata;
  /** Images complémentaires. */
  gallery?: ImageMetadata[];
  /** Titre du produit, utilisé pour les textes alternatifs. */
  title: string;
  /**
   * Identifiant unique de la galerie dans la page. Il est transmis à la
   * visionneuse et à l'événement d'ouverture : deux galeries sur la
   * même page s'ouvrent alors chacune leur propre visionneuse.
   */
  id: string;
  /** Chargement prioritaire, pour l'image principale d'une fiche. */
  eager?: boolean;
}

const { cover, gallery = [], title, id, eager = false } = Astro.props;

const allImages = [cover, ...gallery];

/** Textes alternatifs : le titre seul pour la couverture, le reste numéroté. */
function altFor(index: number): string {
  return index === 0 ? title : `${title} — vue ${index + 1}`;
}

// La visionneuse travaille sur des <img> simples : on lui passe les URL
// déjà optimisées par astro:assets, et non les fichiers originaux.
const lightboxImages = allImages.map((image, index) => ({
  src: image.src,
  alt: altFor(index),
}));

const SIZES = "(min-width: 1024px) 56vw, 100vw";
---

<div class="gallery" data-gallery data-gallery-id={id}>
  <div class="gallery__main">
    {allImages.map((image, index) => (
      <Image
        class={`gallery__img ${index === 0 ? "is-current" : ""}`}
        data-gallery-img
        src={image}
        alt={altFor(index)}
        widths={[400, 800, 1200]}
        sizes={SIZES}
        loading={index === 0 && eager ? "eager" : "lazy"}
        decoding="async"
      />
    ))}

    {/*
      Cible unique qui reçoit le zoom. Elle passe au-dessus pour rester
      atteignable au clavier et porter le clic ; l'image en dessous
      n'a plus besoin d'être elle-même cliquable.
    */}
    <button
      type="button"
      class="gallery__zoom"
      data-gallery-open
      aria-label={`Agrandir les photos de ${title}`}
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
        <path d="M11 8v6" />
        <path d="M8 11h6" />
      </svg>
    </button>
  </div>

  {allImages.length > 1 && (
    <ul class="gallery__thumbs" role="list">
      {allImages.map((image, index) => (
        <li>
          <button
            type="button"
            class={`gallery__thumb ${index === 0 ? "is-active" : ""}`}
            data-gallery-thumb
            data-index={String(index)}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-label={`Voir la vue ${index + 1} sur ${allImages.length}`}
          >
            <Image
              src={image}
              alt=""
              width={168}
              height={126}
              loading="lazy"
              decoding="async"
            />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<Lightbox images={lightboxImages} title={title} id={id} />

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .gallery__main {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .gallery__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-fast) linear;
  }

  .gallery__img.is-current {
    opacity: 1;
  }

  .gallery__zoom {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    color: var(--color-text);
    background-color: rgb(255 255 255 / 0.92);
    box-shadow: var(--shadow-md);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .gallery__zoom:hover {
    background-color: var(--color-surface);
    transform: scale(1.06);
  }

  .gallery__thumbs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-2);
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .gallery__thumbs li {
    flex: none;
    scroll-snap-align: start;
  }

  .gallery__thumb {
    display: block;
    width: 84px;
    height: 63px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-alt);
    opacity: 0.62;
    transition: opacity var(--transition-fast), border-color var(--transition-fast);
  }

  .gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__thumb:hover {
    opacity: 1;
  }

  .gallery__thumb.is-active {
    opacity: 1;
    border-color: var(--color-accent);
  }
</style>

<script>
  /**
   * Gallery — changement de vue et ouverture de la visionneuse.
   *
   * Un seul script pour toutes les galeries : elles sont recherchées à
   * chaque navigation, car un script bundlé ne s'exécute qu'une fois.
   */
  function initGalleries(): void {
    const galleries = document.querySelectorAll<HTMLElement>("[data-gallery]");

    galleries.forEach((gallery) => {
      if (gallery.dataset.initialized === "true") return;
      gallery.dataset.initialized = "true";

      const images = Array.from(
        gallery.querySelectorAll<HTMLElement>("[data-gallery-img]")
      );
      const thumbs = Array.from(
        gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")
      );
      const openBtn = gallery.querySelector<HTMLButtonElement>("[data-gallery-open]");
      if (images.length === 0) return;

      // Identifiant porté par l'événement : il doit correspondre à celui
      // de la visionneuse rendue à côté, sinon rien ne s'ouvre.
      const galleryId = gallery.dataset.galleryId;
      if (!galleryId) return;

      let index = 0;

      const show = (next: number): void => {
        index = next;

        thumbs.forEach((thumb, i) => {
          const active = i === index;
          thumb.classList.toggle("is-active", active);
          thumb.setAttribute("aria-pressed", active ? "true" : "false");
        });

        images.forEach((image, i) => {
          image.classList.toggle("is-current", i === index);
        });
      };

      thumbs.forEach((thumb, i) => {
        thumb.addEventListener("click", () => show(i));
      });

      openBtn?.addEventListener("click", () => {
        window.dispatchEvent(
          new CustomEvent("lightbox:ouvrir", { detail: { id: galleryId, index } })
        );
      });

      // Flèches au clavier dans la bande de vignettes.
      gallery.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        if (!(event.target as HTMLElement).matches("[data-gallery-thumb]")) return;

        event.preventDefault();
        const delta = event.key === "ArrowRight" ? 1 : -1;
        const next = Math.min(Math.max(index + delta, 0), thumbs.length - 1);
        show(next);
        thumbs[next].focus();
      });

      show(0);
    });
  }

  initGalleries();
  document.addEventListener("astro:page-load", initGalleries);
</script>