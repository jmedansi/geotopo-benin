---
/**
 * Gallery.astro — Galerie d'images interactive & responsive.
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  cover: ImageMetadata;
  gallery?: ImageMetadata[];
  title: string;
  id: string;
  eager?: boolean;
}

const { cover, gallery = [], title, id, eager = false } = Astro.props;

const allImages = [cover, ...gallery];

function altFor(index: number): string {
  return index === 0 ? title : `${title} — vue ${index + 1}`;
}

const SIZES = "(min-width: 1024px) 56vw, 100vw";
---

<div class="gallery" data-gallery data-gallery-id={id}>
  <div class="gallery__main">
    {allImages.map((image, index) => (
      <Image
        class={`gallery__img ${index === 0 ? "is-current" : ""}`}
        data-gallery-img
        data-index={String(index)}
        data-src={image.src}
        data-alt={altFor(index)}
        src={image}
        alt={altFor(index)}
        widths={[400, 800, 1200]}
        sizes={SIZES}
        loading={index === 0 && eager ? "eager" : "lazy"}
        decoding="async"
        style={index === 0 ? "opacity: 1; z-index: 5; pointer-events: auto;" : "opacity: 0; z-index: 1; pointer-events: none;"}
      />
    ))}

    <button
      type="button"
      class="gallery__zoom"
      data-gallery-open
      data-lightbox-src={cover.src}
      data-lightbox-alt={altFor(0)}
      aria-label={`Agrandir les photos de ${title}`}
      title="Agrandir l'image"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
        <path d="M11 8v6" />
        <path d="M8 11h6" />
      </svg>
    </button>
  </div>

  {allImages.length > 1 && (
    <ul class="gallery__thumbs" role="list">
      {allImages.map((image, index) => (
        <li>
          <button
            type="button"
            class={`gallery__thumb ${index === 0 ? "is-active" : ""}`}
            data-gallery-thumb
            data-index={String(index)}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-label={`Voir l'image ${index + 1} sur ${allImages.length}`}
          >
            <Image
              src={image}
              alt=""
              width={168}
              height={126}
              loading="lazy"
              decoding="async"
            />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
.gallery {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
  max-width: 100%;
}

.gallery__main {
  position: relative;
  width: 100%;
  max-width: 100%;
  aspect-ratio: 4 / 3;
  background-color: #121722;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
}

.gallery__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s ease;
}

.gallery__img.is-current {
  opacity: 1 !important;
  z-index: 5 !important;
  pointer-events: auto !important;
}

.gallery__zoom {
  position: absolute;
  right: 16px;
  bottom: 16px;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  color: #FFFFFF;
  background: rgba(11, 14, 20, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  cursor: pointer;
  transition: all 0.2s ease;
}

.gallery__zoom:hover {
  background: #FF6B00;
  color: #FFFFFF;
  border-color: #FF6B00;
  transform: scale(1.08);
  box-shadow: 0 6px 20px rgba(255, 107, 0, 0.4);
}

.gallery__thumbs {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 8px;
  max-width: 100%;
  scroll-snap-type: x proximity;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 107, 0, 0.4) transparent;
}

.gallery__thumbs::-webkit-scrollbar {
  height: 6px;
}
.gallery__thumbs::-webkit-scrollbar-thumb {
  background: rgba(255, 107, 0, 0.4);
  border-radius: 4px;
}

.gallery__thumbs li {
  flex: none;
  scroll-snap-align: start;
}

.gallery__thumb {
  display: block;
  width: 90px;
  height: 68px;
  padding: 0;
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  overflow: hidden;
  background-color: #121722;
  opacity: 0.6;
  cursor: pointer;
  transition: all 0.2s ease;
}

.gallery__thumb :global(img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gallery__thumb:hover {
  opacity: 0.9;
  border-color: rgba(255, 107, 0, 0.5);
}

.gallery__thumb.is-active {
  opacity: 1;
  border-color: #FF6B00;
  box-shadow: 0 0 12px rgba(255, 107, 0, 0.4);
}
</style>

<script>
function initGalleries(): void {
  const galleries = document.querySelectorAll<HTMLElement>("[data-gallery]");

  galleries.forEach((gallery) => {
    const images = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-img]"));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]"));
    const openBtn = gallery.querySelector<HTMLButtonElement>("[data-gallery-open]");

    if (images.length === 0) return;
    if (gallery.dataset.ready === "true") return;
    gallery.dataset.ready = "true";

    let currentIndex = 0;

    const show = (next: number): void => {
      currentIndex = next;

      // Met à jour les vignettes
      thumbs.forEach((thumb, i) => {
        const active = i === currentIndex;
        thumb.classList.toggle("is-active", active);
        thumb.setAttribute("aria-pressed", active ? "true" : "false");
      });

      // Met à jour l'image principale
      images.forEach((img, i) => {
        const isCurrent = i === currentIndex;
        img.classList.toggle("is-current", isCurrent);
        if (isCurrent) {
          img.style.opacity = "1";
          img.style.zIndex = "5";
          img.style.pointerEvents = "auto";
          // Met à jour les métadonnées du bouton zoom
          if (openBtn) {
            const src = img.dataset.src || img.getAttribute("src") || "";
            const alt = img.dataset.alt || img.getAttribute("alt") || "";
            openBtn.setAttribute("data-lightbox-src", src);
            openBtn.setAttribute("data-lightbox-alt", alt);
          }
        } else {
          img.style.opacity = "0";
          img.style.zIndex = "1";
          img.style.pointerEvents = "none";
        }
      });
    };

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener("click", (e) => {
        e.preventDefault();
        show(i);
      });
    });

    show(0);
  });
}

initGalleries();
document.addEventListener("astro:page-load", initGalleries);
</script>