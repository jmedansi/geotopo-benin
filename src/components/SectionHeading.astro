---
/**
 * SectionHeading.astro — En-tête de section avec contraste maximal.
 */

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  class?: string;
}

const { eyebrow, title, subtitle, align = "center", class: extraClass = "" } = Astro.props;
---

<div class={`section-heading section-heading--${align} ${extraClass}`.trim()} data-reveal="up">
  {eyebrow && <span class="section-heading__eyebrow">{eyebrow}</span>}
  <h2 class="section-heading__title">{title}</h2>
  
  <svg class="section-heading__line" viewBox="0 0 120 8" fill="none" aria-hidden="true">
    <path d="M 0 4 L 120 4" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" data-draw="true"/>
  </svg>

  {subtitle && <p class="section-heading__subtitle">{subtitle}</p>}
</div>

<style>
.section-heading {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-10);
}

.section-heading--center {
  align-items: center;
  text-align: center;
}

.section-heading--left {
  align-items: flex-start;
  text-align: left;
}

.section-heading__eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
  margin-bottom: var(--space-2);
}

.section-heading__title {
  font-family: var(--font-serif);
  font-size: var(--text-3xl);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  color: #FFFFFF !important;
}

@media (min-width: 768px) {
  .section-heading__title {
    font-size: var(--text-4xl);
  }
}

.section-heading__line {
  width: 80px;
  height: 8px;
  margin-block: var(--space-3);
}

.section-heading__subtitle {
  font-size: var(--text-lg);
  color: #E2E8F0 !important;
  max-width: 54ch;
  line-height: var(--leading-relaxed);
}
</style>