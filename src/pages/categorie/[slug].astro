---
/**
 * src/pages/categorie/[slug].astro — Page dédiée d'une catégorie.
 * Route statique dynamique générant chaque page de catégorie.
 */

import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Contours from "../../components/Contours.astro";
import Crosshair from "../../components/Crosshair.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProductCard from "../../components/ProductCard.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Accordion from "../../components/Accordion.astro";
import ScrollProgress from "../../components/ScrollProgress.astro";

import { getCategories, getProductsByCategory } from "../../lib/catalog";

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((cat) => ({
    params: { slug: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const { title, description, tagline, cover, tips, faq } = category.data;
const { Content } = await render(category);

const categoryProducts = await getProductsByCategory(category.id);
const allCategories = await getCategories();
const otherCategories = allCategories.filter((c) => c.id !== category.id);
---

<Base title={title} description={description}>
  <ScrollProgress />
  <Crosshair />

  <!-- Hero Catégorie avec couverture en parallaxe -->
  <section class="cat-hero" data-crosshair>
    <Contours variant="hero" draw={true} />
    {cover && (
      <div class="cat-hero__bg-wrapper" data-parallax="0.15">
        <Image src={cover} alt={title} width={1200} height={600} class="cat-hero__bg-image" />
        <div class="cat-hero__bg-overlay"></div>
      </div>
    )}

    <div class="container cat-hero__inner">
      <Breadcrumbs items={[{ label: "Boutique", href: "/boutique" }, { label: title }]} />

      {tagline && <span class="cat-hero__tagline">{tagline}</span>}
      <h1 class="cat-hero__title" data-reveal="up">{title}</h1>
      <p class="cat-hero__desc" data-reveal="up" data-reveal-delay="100">{description}</p>
    </div>
  </section>

  <!-- Présentation & Corps Markdown -->
  <section class="section">
    <div class="container">
      <div class="prose" style="margin-inline: auto;" data-reveal="up">
        <Content />
      </div>
    </div>
  </section>

  <!-- Conseils "Comment choisir" (tips) -->
  {tips && tips.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <SectionHeading
          eyebrow="GUIDE D'ACHAT"
          title={`Comment choisir dans la gamme ${title}`}
          subtitle="Les critères techniques essentiels à vérifier avant de passer commande."
        />

        <div class="grid-tips" data-stagger="0.1">
          {tips.map((tip, idx) => (
            <div class="tip-card" data-reveal="up">
              <span class="tip-card__num">0{idx + 1}</span>
              <h3 class="tip-card__title">{tip.title}</h3>
              <p class="tip-card__text">{tip.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Grille des produits de la catégorie -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="ÉQUIPEMENTS DISPONIBLES"
        title={`Produits ${title}`}
        subtitle={`${categoryProducts.length} référence(s) sélectionnée(s) et qualifiée(s) pour le terrain.`}
      />

      {categoryProducts.length > 0 ? (
        <div class="product-grid" data-stagger="0.08">
          {categoryProducts.map((prod) => (
            <ProductCard product={prod} />
          ))}
        </div>
      ) : (
        <p style="text-align: center; color: var(--color-text-muted);">
          Aucun produit actuellement répertorié dans cette catégorie.
        </p>
      )}
    </div>
  </section>

  <!-- FAQ de la catégorie -->
  {faq && faq.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <SectionHeading
          eyebrow="QUESTIONS FRÉQUENTES"
          title={`FAQ — ${title}`}
        />
        <Accordion items={faq} />
      </div>
    </section>
  )}

  <!-- Bande "Autres catégories" -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="CONTINUER LA NAVIGATION"
        title="Explorez d'autres catégories"
      />
      <div class="category-grid" data-stagger="0.08">
        {otherCategories.slice(0, 4).map((otherCat) => (
          <CategoryCard category={otherCat} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Sur-mesure -->
  <section class="cat-cta-section" data-crosshair>
    <Contours variant="dense" draw={true} />
    <div class="container cat-cta-section__inner" data-reveal="up">
      <h2 class="cat-cta-section__title">Un modèle particulier en tête ?</h2>
      <p class="cat-cta-section__text">
        Nous pouvons importer sur commande n'importe quel modèle spécifique de cette gamme sous 15 à 25 jours.
      </p>
      <a href="/sur-mesure" class="btn btn--primary btn--lg">
        Demander un devis sur-mesure &rarr;
      </a>
    </div>
  </section>
</Base>

<style>
.cat-hero {
  position: relative;
  min-height: 340px;
  display: flex;
  align-items: center;
  background-color: var(--color-bg-alt);
  color: #FFFFFF;
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
  padding-block: var(--space-12);
}

.cat-hero__bg-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 120%;
}

.cat-hero__bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.25;
}

.cat-hero__bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(11, 14, 20, 0.6) 0%, rgba(11, 14, 20, 0.95) 100%);
}

.cat-hero__inner {
  position: relative;
  z-index: 2;
  max-width: 800px;
}

.cat-hero__tagline {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
}

.cat-hero__title {
  font-family: var(--font-serif);
  font-size: var(--text-4xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-block: var(--space-2);
}

.cat-hero__desc {
  font-size: var(--text-lg);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
}

.grid-tips {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-6);
}

.tip-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  box-shadow: var(--shadow-xs);
}

.tip-card__num {
  font-family: var(--font-mono);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: var(--color-accent);

  display: inline-block;
  margin-bottom: var(--space-3);
}

.tip-card__title {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-2);
}

.tip-card__text {
  font-size: var(--text-sm);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
}

.cat-cta-section {
  position: relative;
  background-color: var(--color-bg-alt);
  color: #FFFFFF;
  padding-block: var(--space-16);
  border-top: 1px solid var(--color-border);
  text-align: center;
  overflow: hidden;
}

.cat-cta-section__inner {
  position: relative;
  z-index: 2;
  max-width: 600px;
  margin-inline: auto;
}

.cat-cta-section__title {
  font-family: var(--font-serif);
  font-size: var(--text-3xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-3);
}

.cat-cta-section__text {
  font-size: var(--text-base);
  color: #E2E8F0;
  margin-bottom: var(--space-6);
}
</style>
