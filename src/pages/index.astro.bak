}

.step-card__title {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-2);
}

.step-card__text {
  font-size: var(--text-xs);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
  margin: 0;
}

/* Avis Clients / Témoignages */
.grid-testimonials {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-6);
}

.testimonial-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.testimonial-stars {
  color: #FFB800;
  font-size: 18px;
  letter-spacing: 2px;
  margin-bottom: var(--space-4);
}

.testimonial-text {
  font-size: var(--text-sm);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
  font-style: italic;
  margin-bottom: var(--space-6);
}

.testimonial-author-box {
  display: flex;
  gap: var(--space-3);
  align-items: center;
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border);
}

.author-avatar-badge {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-full);
  background-color: rgba(255, 107, 0, 0.2);
  border: 1px solid var(--color-accent);
  color: var(--color-accent);
  font-family: var(--font-mono);
  font-weight: var(--weight-bold);
  font-size: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-family: var(--font-serif);
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
}

.author-role {
  font-size: var(--text-xs);
  color: var(--color-accent);
  font-weight: var(--weight-medium);
}

.author-location {
  font-size: 11px;
  color: #E2E8F0;
}

.author-equipment {
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--color-text-dim);
  margin-top: 2px;
}

/* CTA Final Sombre */
.cta-final-section {
  position: relative;
  background-color: #0B0E14;
  color: #FFFFFF;
  padding-block: var(--space-20);
  overflow: hidden;
  margin-top: var(--space-12);
  border-top: 1px solid var(--color-border);
}

.cta-final-section__inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 800px;
  margin-inline: auto;
}

.cta-final-section__eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  letter-spacing: var(--tracking-widest);
}

.cta-final-section__title {
  font-family: var(--font-serif);
  font-size: var(--text-3xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-block: var(--space-4);
  line-height: var(--leading-tight);
}

@media (min-width: 768px) {
  .cta-final-section__title {
    font-size: var(--text-4xl);
  }
}

.cta-final-section__text {
  font-size: var(--text-base);
  color: #E2E8F0;
  margin-bottom: var(--space-8);
  line-height: var(--leading-relaxed);
}

.cta-final-section__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  justify-content: center;
}
</style>

<script>
function initMetierTabs() {
  const tabsContainer = document.getElementById("topo-tabs-component");
  if (!tabsContainer) return;

  tabsContainer.addEventListener("tab-changed", (e: any) => {
    const tabId = e.detail?.tabId;
    if (!tabId) return;

    const panels = document.querySelectorAll<HTMLElement>(".metier-panel");
    panels.forEach((panel) => {
      if (panel.id === `panel-${tabId}`) {
        panel.style.display = "block";
      } else {
        panel.style.display = "none";
      }
    });
  });
}

initMetierTabs();
document.addEventListener("astro:page-load", initMetierTabs);
</script>
