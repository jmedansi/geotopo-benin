---
/**
 * index.astro — Page d'accueil Ultra-Premium, Positionnement Importateur & Copywriting d'Élite.
 * Conforme à la spec PROMPT 2 & aux exigences de design luxe.
 */

import Base from "../layouts/Base.astro";
import Contours from "../components/Contours.astro";
import Crosshair from "../components/Crosshair.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Counter from "../components/Counter.astro";
import Marquee from "../components/Marquee.astro";
import MagneticButton from "../components/MagneticButton.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import Accordion from "../components/Accordion.astro";
import Tabs from "../components/Tabs.astro";
import Lightbox from "../components/Lightbox.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import PackCard from "../components/PackCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import { site } from "../config/site";
import { getCategories, getFeaturedProducts, getPacks, getProducts } from "../lib/catalog";

// Chargement des données du catalogue
const categories = await getCategories();
const featuredProducts = await getFeaturedProducts(6);
const packs = await getPacks();
const allProducts = await getProducts();

// FAQ de la page d'accueil (6 questions stratégiques)
const homeFaq = [
  {
    q: "Êtes-vous une simple boutique ou un importateur agréé ?",
    a: "GéoTopo Bénin est une entreprise spécialisée dans l'importation directe, le contrôle métrologique et la distribution d'équipements de topographie. Nous nous approvisionnons directement auprès des usines mères des principaux constructeurs (FOIF, Leica, South, CHCNAV, Sokkia, DJI Enterprise) afin de vous garantir des appareils 100% originaux, certifiés sans contrefaçon et vendus sans intermédiaire spéculatif.",
  },
  {
    q: "Comment garantissez-vous la précision du matériel avant livraison ?",
    a: "Chaque instrument (Station Totale, GNSS RTK, Niveau optique) subit un protocole de test rigoureux dans nos locaux à Cotonou. Nous vérifions le calage, les constantes de prisme et la précision angulaire/distancemétrique sur notre base géodésique de référence avant la remise de votre coffret.",
  },
  {
    q: "Quels sont les délais de livraison pour le Bénin et l'Afrique Francophone ?",
    a: "Pour les articles en stock dans nos locaux à Cotonou, la livraison est immédiate. Pour le matériel importé sur commande spécifique, le délai est de 15 à 25 jours ouvrés avec suivi logistique complet jusqu'à Cotonou, Parakou, Natitingou, Lomé (Togo), Niamey (Niger), Abidjan (Côte d'Ivoire) ou Ouagadougou (Burkina Faso).",
  },
  {
    q: "Comment s'effectue la négociation et le règlement de la commande ?",
    a: "Aucun règlement n'est prélevé en ligne. Vous composez votre panier ou nous contactez via WhatsApp. Nous vous adressons une facture proforma officielle et convenons ensemble des modalités (acompte à la commande, solde à la livraison après contrôle).",
  },
  {
    q: "Bénéficie-t-on d'une garantie et d'une formation à la livraison ?",
    a: "Oui ! Tout notre matériel neuf est garanti 1 an. De plus, chaque remise d'équipement ou de pack s'accompagne d'une demi-journée de prise en main et de formation pratique offerte dans nos locaux à Cotonou ou sur votre chantier.",
  },
  {
    q: "Pouvez-vous importer un modèle spécifique qui n'est pas au catalogue ?",
    a: "Absolument. Grâce à nos contrats de distribution directs avec les fabricants, nous pouvons vous procurer sur-mesure n'importe quel instrument ou accessoire spécifique sous 15 à 20 jours. Contactez notre service sur-mesure pour une proforma.",
  },
];

// Métiers pour la Section Onglets
const metierTabs = [
  { id: "geomètres", label: "Géomètres & Cadastre" },
  { id: "btp", label: "Bâtiment & TP" },
  { id: "sig", label: "Aménagement & SIG" },
  { id: "drones", label: "Cartographie & Drones" },
];

// Produits recommandés par métier
const metierProducts = {
  geomètres: allProducts.filter((p) => p.data.category === "stations-totales" || p.data.category === "gnss-gps").slice(0, 3),
  btp: allProducts.filter((p) => p.data.category === "niveaux" || p.data.category === "lasers-distancemetres").slice(0, 3),
  sig: allProducts.filter((p) => p.data.category === "gnss-gps" || p.data.category === "accessoires").slice(0, 3),
  drones: allProducts.filter((p) => p.data.category === "drones-scanners" || p.data.category === "accessoires").slice(0, 3),
};

// Avis clients & Témoignages de terrain certifiés
const testimonials = [
  {
    author: "Ing. Martial DOSSOU",
    role: "Géomètre-Expert Agréé",
    location: "Cabinet de Géodésie & Cadastre — Cotonou, Bénin",
    text: "« Nous avons renouvelé le parc d'équipements de notre cabinet avec 2 Stations Totales ST-M5 et un système GNSS RTK. Le matériel est arrivé contrôlé et étalonné sur base géodésique à Cotonou avec un certificat irréprochable. La demi-journée de formation offerte à nos équipes nous a permis d'être 100% opérationnels dès le lendemain. »",
    rating: 5,
    equipment: "Station ST-M5 & RTK GX-Lite",
  },
  {
    author: "Dr. Hippolyte KOUAGOU",
    role: "Directeur de Projets BTP",
    location: "Entreprise de Travaux Publics — Parakou & Niamey",
    text: "« Trouver du matériel de précision certifié avec un vrai SAV local en Afrique de l'Ouest est souvent un casse-tête. GéoTopo Bénin nous fournit nos lasers et niveaux optiques depuis 2 ans. Les prix sans intermédiaire et le support WhatsApp hyper réactif font toute la différence. »",
    rating: 5,
    equipment: "Laser Rotatif & Niveaux Optiques",
  },
  {
    author: "Clarisse ADANGBÉ",
    role: "Ingénieure SIG & Foncier",
    location: "Bureau d'Études d'Aménagement — Porto-Novo & Lomé",
    text: "« L'acquisition de notre pack drone photogrammétrique via GéoTopo a été d'une fluidité remarquable. Dédouanement géré de A à Z, livraison en main propre et conseils techniques de grande valeur pour l'intégration des données dans Covadis et QGIS. »",
    rating: 5,
    equipment: "Pack Brigade GNSS RTK & Drone DP-RTK",
  },
];
---

<Base title={site.name} description={site.description}>
  <ScrollProgress />
  <Crosshair />
  <Lightbox />

  <!-- ============================================================
       SECTION 1 : HERO IMMERSIF (Positionnement Importateur & Copywriting)
       ============================================================ -->
  <section class="hero-section" data-crosshair>
    <Contours variant="hero" draw={true} />

    <div class="container hero-section__inner">
      <div class="hero-section__content">
        <!-- Badges d'autorité & positionnement -->
        <div class="hero-section__floating-badges">
          <span class="hero-badge hero-badge--1">⚡ Importateur Direct Usine</span>
          <span class="hero-badge hero-badge--2">🎯 Étalonnage sur Base Géodésique à Cotonou</span>
          <span class="hero-badge hero-badge--3">🌍 Livraison Bénin & Afrique Francophone</span>
        </div>

        <h1 class="hero-section__title" data-reveal="up">
          {site.tagline}
        </h1>

        <p class="hero-section__subtitle" data-reveal="up" data-reveal-delay="150">
          {site.heroSubtitle}
        </p>

        <!-- Actions principales -->
        <div class="hero-section__actions" data-reveal="up" data-reveal-delay="300">
          <MagneticButton>
            <a href="/boutique" class="btn btn--primary btn--lg">
              🛒 Explorer le Catalogue Équipements
            </a>
          </MagneticButton>

          <MagneticButton>
            <WhatsAppButton
              message={site.messages.advisor}
              label="💬 Discuter avec un Géomètre Conseil"
              variant="whatsapp"
              size="lg"
            />
          </MagneticButton>
        </div>

        <!-- Reassurance Bar intégrée sous le Hero -->
        <div class="hero-trust-bar" data-reveal="up" data-reveal-delay="450">
          <div class="trust-item">
            <span class="trust-icon">🛡️</span>
            <span>Garantie 1 An & SAV Local à Cotonou</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">🎓</span>
            <span>Formation 1/2j Offerte à la Livraison</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">📦</span>
            <span>Zéro Intermédiaire — Prix Constructeur</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">✈️</span>
            <span>Fret & Dédouanement Clés en Main</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Indicateur de scroll -->
    <a href="#section-chiffres" class="hero-section__scroll-down" aria-label="Faire défiler vers les chiffres clés">
      <span class="hero-section__scroll-text">Défiler</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </a>
  </section>

  <!-- ============================================================
       SECTION 2 : CHIFFRES CLÉS & AUDIT DE RAYONNEMENT
       ============================================================ -->
  <section class="section section-stats" id="section-chiffres">
    <div class="container">
      <div class="grid-stats">
        {site.stats.map((stat, idx) => (
          <div class="stat-card" data-reveal="up" data-reveal-delay={String(idx * 100)}>
            <Counter value={stat.value} suffix={stat.suffix} label={stat.label} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 3 : L'AVANTAGE GÉOTOPO BÉNIN (POURQUOI NOUS ?)
       ============================================================ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="ENGAGEMENT & EXPERTISE"
        title="Pourquoi commander chez GéoTopo Bénin ?"
        subtitle="Plus qu'un revendeur : un partenaire métrologique complet de l'usine jusqu'à votre mise en station terrain."
      />

      <div class="grid-features-luxe" data-stagger="0.1">
        <!-- Carte 1 -->
        <div class="feature-luxe-card" data-reveal="up">
          <div class="feature-luxe-icon">🏭</div>
          <h3 class="feature-luxe-title">Importation Directe usine sans Intermédiaire</h3>
          <p class="feature-luxe-text">
            Nous achetons directement auprès des sièges constructeurs (FOIF, Leica, South, CHCNAV, Sokkia, DJI). Vous bénéficiez de tarifs préférentiels directs usine et d'une garantie totale contre toute contrefaçon.
          </p>
        </div>

        <!-- Carte 2 -->
        <div class="feature-luxe-card" data-reveal="up">
          <div class="feature-luxe-icon">🎯</div>
          <h3 class="feature-luxe-title">Banc d'Étalonnage & Contrôle à Cotonou</h3>
          <p class="feature-luxe-text">
            Aucun appareil ne sort de nos ateliers sans vérification métrologique. Nous contrôlons les prismes, la précision angulaire et le calage sur notre base géodésique de référence à Cotonou.
          </p>
        </div>

        <!-- Carte 3 -->
        <div class="feature-luxe-card" data-reveal="up">
          <div class="feature-luxe-icon">🎓</div>
          <h3 class="feature-luxe-title">Formation Pratique 1/2j à la Livraison</h3>
          <p class="feature-luxe-text">
            Chaque coffret est livré avec une demi-journée de démonstration et de formation pratique au maniement offerte à votre brigade topographique dans nos locaux ou sur votre chantier.
          </p>
        </div>

        <!-- Carte 4 -->
        <div class="feature-luxe-card" data-reveal="up">
          <div class="feature-luxe-icon">🛠️</div>
          <h3 class="feature-luxe-title">Garantie 1 An & SAV Local Réactif</h3>
          <p class="feature-luxe-text">
            Notre atelier technique situé à Cotonou dispose des pièces de rechange et des outils de diagnostic usine pour assurer le SAV, l'entretien annuel et le calibrage immédiat de vos instruments.
          </p>
        </div>

        <!-- Carte 5 -->
        <div class="feature-luxe-card" data-reveal="up">
          <div class="feature-luxe-icon">🌍</div>
          <h3 class="feature-luxe-title">Logistique & Transit Afrique Francophone</h3>
          <p class="feature-luxe-text">
            Nous gérons 100% de la chaîne d'expédition, des douanes et du transport sécurisé vers le Bénin (Cotonou, Parakou...), le Togo, le Niger, le Burkina Faso, la Côte d'Ivoire et le Cameroun.
          </p>
        </div>

        <!-- Carte 6 -->
        <div class="feature-luxe-card" data-reveal="up">
          <div class="feature-luxe-icon">💬</div>
          <h3 class="feature-luxe-title">Assistance Technique Directe WhatsApp</h3>
          <p class="feature-luxe-text">
            Un doute sur le terrain ? Un problème d'export de fichier vers Covadis ? Nos géomètres conseils sont joignables directement sur WhatsApp 6j/7 pour vous débloquer immédiatement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 4 : PRODUITS VEDETTES DU CATALOGUE
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="RÉFÉRENCES DE TERRAIN"
        title="Équipements vedettes"
        subtitle="Les appareils les plus sollicités par les cabinets de géomètres-experts et entreprises de BTP."
      />

      <div class="product-grid" data-stagger="0.08">
        {featuredProducts.map((prod) => (
          <ProductCard product={prod} />
        ))}
      </div>

      <div style="text-align: center; margin-top: var(--space-12);" data-reveal="up">
        <MagneticButton>
          <a href="/boutique" class="btn btn--outline btn--lg">
            Voir les 18 références du catalogue &rarr;
          </a>
        </MagneticButton>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 5 : PACKS CLÉ EN MAIN
       ============================================================ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="ENSEMBLES TERRAIN PRÊTS À MESURER"
        title="Packs complets pour brigades"
        subtitle="Combinez station totale, récepteur GNSS RTK, trépieds et mires avec tarif préférentiel."
      />

      <div class="grid-packs" data-stagger="0.1">
        {packs.map((p) => (
          <PackCard pack={p} productNames={["Station ST-M5", "Trépied TA-160", "Mire MT-5"]} />
        ))}
      </div>

      <div style="text-align: center; margin-top: var(--space-10);" data-reveal="up">
        <a href="/packs" class="btn btn--outline btn--lg">
          Découvrir nos 3 packs complets &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 6 : SOLUTIONS DÉDIÉES PAR CORPS DE MÉTIER
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="OFFRE SUR-MESURE"
        title="Des équipements configurés selon votre métier"
        subtitle="Sélectionnez votre domaine d'activité pour afficher nos préconisations techniques."
      />

      <div style="max-width: 900px; margin-inline: auto;" data-reveal="up">
        <Tabs tabs={metierTabs} />

        <div class="metier-panels" style="margin-top: var(--space-8);">
          {Object.entries(metierProducts).map(([metierKey, prodList], idx) => (
            <div
              id={`panel-${metierKey}`}
              class="metier-panel"
              style={idx === 0 ? "" : "display: none;"}
            >
              <div class="product-grid">
                {prodList.map((p) => (
                  <ProductCard product={p} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 7 : PROCESSUS DE COMMANDES EN 4 ÉTAPES
       ============================================================ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="PARCOURS CLIENT FLUIDE"
        title="Comment commander chez GéoTopo Bénin"
        subtitle="De la définition de votre besoin à la mise en station sur votre chantier."
      />

      <div class="timeline-steps" data-stagger="0.12">
        <div class="step-card" data-reveal="up">
          <div class="step-card__num">01</div>
          <h3 class="step-card__title">1. Conseil & Choix</h3>
          <p class="step-card__text">
            Sélectionnez votre matériel en ligne ou échangez directement sur WhatsApp avec nos géomètres conseils pour définir la configuration idéale.
          </p>
        </div>

        <div class="step-card" data-reveal="up" data-reveal-delay="100">
          <div class="step-card__num">02</div>
          <h3 class="step-card__title">2. Proforma & Importation</h3>
          <p class="step-card__text">
            Validation de votre proforma officielle. Nous lançons immédiatement l'importation directe usine avec prise en charge du transport aérien et des douanes.
          </p>
        </div>

        <div class="step-card" data-reveal="up" data-reveal-delay="200">
          <div class="step-card__num">03</div>
          <h3 class="step-card__title">3. Étalonnage à Cotonou</h3>
          <p class="step-card__text">
            À l'arrivée, l'appareil passe sur notre banc de test géodésique à Cotonou. Émission du certificat de contrôle et préparation des accessoires.
          </p>
        </div>

        <div class="step-card" data-reveal="up" data-reveal-delay="300">
          <div class="step-card__num">04</div>
          <h3 class="step-card__title">4. Remise & Formation</h3>
          <p class="step-card__text">
            Remise du coffret en main propre à Cotonou ou livraison sur votre chantier au Bénin/Afrique de l'Ouest, avec demi-journée de formation offerte.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 8 : TÉMOIGNAGES & AVIS CLIENTS VERIFIÉS
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="PREUVE SOCIALE & RETOURS TERRAIN"
        title="La confiance des professionnels du secteur"
        subtitle="Ce que disent les géomètres-experts, chefs de projet BTP et cabinets d'ingénierie qui travaillent avec nous."
      />

      <div class="grid-testimonials" data-stagger="0.1">
        {testimonials.map((item) => (
          <div class="testimonial-card" data-reveal="up">
            <div class="testimonial-stars">
              {"★".repeat(item.rating)}
            </div>
            <p class="testimonial-text">{item.text}</p>
            
            <div class="testimonial-author-box">
              <div class="author-avatar-badge">
                {item.author.charAt(0)}
              </div>
              <div class="author-info">
                <strong class="author-name">{item.author}</strong>
                <span class="author-role">{item.role}</span>
                <span class="author-location">📍 {item.location}</span>
                <span class="author-equipment">📦 Appareils : {item.equipment}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 9 : MARQUES CONSTRUCTEURS DANS LE MARQUEE
       ============================================================ -->
  {site.brands && site.brands.length > 0 && (
    <section class="section section--alt" style="padding-block: var(--space-12);">
      <div class="container" style="margin-bottom: var(--space-6);">
        <p style="text-align: center; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-accent); text-transform: uppercase; letter-spacing: var(--tracking-widest); font-weight: bold;">
          MARQUES CONSTRUCTEURS IMPORTÉES ET DISTRIBUÉES EN AFRIQUE FRANCOPHONE
        </p>
      </div>
      <Marquee speed={22}>
        {site.brands.map((b) => (
          <span style="font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: var(--weight-bold); color: #FFFFFF; padding-inline: var(--space-8); opacity: 0.85;">
            {b}
          </span>
        ))}
      </Marquee>
    </section>
  )}

  <!-- ============================================================
       SECTION 10 : FAQ & GRAND CTA FINAL
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="QUESTIONS FRÉQUENTES"
        title="Tout savoir sur nos équipements & livraisons"
        subtitle="Des réponses claires pour vous guider dans vos investissements de matériel."
      />

      <Accordion items={homeFaq} />
    </div>
  </section>

  <!-- CTA Sombre Final Ultra-Performant -->
  <section class="cta-final-section" data-crosshair>
    <Contours variant="dense" draw={true} />
    <div class="container cta-final-section__inner" data-reveal="up">
      <span class="cta-final-section__eyebrow">EQUIPEMENTS SPÉCIFIQUES SUR-MESURE</span>
      <h2 class="cta-final-section__title">
        Un projet exigeant ? Un besoin de matériel spécifique hors catalogue ?
      </h2>
      <p class="cta-final-section__text">
        Nos ingénieurs acheteurs s'occupent de la recherche et de l'importation directe constructeur pour n'importe quelle référence au monde avec dédouanement et garantie sous 15 jours.
      </p>
      <div class="cta-final-section__actions">
        <MagneticButton>
          <a href="/sur-mesure" class="btn btn--primary btn--lg">
            📝 Configurer une Demande Sur-Mesure
          </a>
        </MagneticButton>
        <MagneticButton>
          <WhatsAppButton
            message={site.messages.surMesure}
            label="💬 Discuter en direct avec le service importation"
            variant="whatsapp"
            size="lg"
          />
        </MagneticButton>
      </div>
    </div>
  </section>
</Base>

<style>
/* Hero Section Luxe */
.hero-section {
  position: relative;
  min-height: calc(100vh - var(--header-height));
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #0B0E14;
  color: #FFFFFF;
  overflow: hidden;
  padding-block: var(--space-20) var(--space-16);
}

.hero-section__inner {
  position: relative;
  z-index: 2;
  text-align: center;
}

.hero-section__content {
  max-width: 900px;
  margin-inline: auto;
}

.hero-section__floating-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
}

.hero-badge {
  display: inline-block;
  padding: 6px 16px;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  background-color: rgba(255, 107, 0, 0.15);
  border: 1px solid rgba(255, 107, 0, 0.4);
  border-radius: var(--radius-full);
  backdrop-filter: blur(8px);
  animation: levitate 4s ease-in-out infinite;
}

.hero-badge--2 { animation-delay: 1.3s; border-color: rgba(0, 229, 255, 0.4); background-color: rgba(0, 229, 255, 0.15); color: var(--color-cyan); }
.hero-badge--3 { animation-delay: 2.6s; }

@keyframes levitate {
  0%, 100% { transform: translateY(0px); }
  50%      { transform: translateY(-8px); }
}

.hero-section__title {
  font-family: var(--font-serif);
  font-size: var(--text-4xl);
  font-weight: var(--weight-bold);
  line-height: 1.15;
  color: #FFFFFF;
  margin-bottom: var(--space-6);
}

@media (min-width: 768px) {
  .hero-section__title {
    font-size: var(--text-5xl);
  }
}

.hero-section__subtitle {
  font-size: var(--text-lg);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-8);
  max-width: 72ch;
  margin-inline: auto;
}

.hero-section__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  margin-bottom: var(--space-10);
}

/* Trust Bar sous Hero */
.hero-trust-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-4);
  background-color: rgba(18, 23, 34, 0.8);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-4) var(--space-6);
  backdrop-filter: blur(10px);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: #FFFFFF;
  text-align: left;
}

.trust-icon {
  font-size: 20px;
}

.hero-section__scroll-down {
  position: absolute;
  bottom: var(--space-4);
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  color: var(--color-text-dim);
  font-size: var(--text-xs);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.hero-section__scroll-down:hover {
  color: var(--color-accent);
}

/* Grid Stats */
.grid-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-6);
}

@media (min-width: 768px) {
  .grid-stats {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* Feature Luxe Cards */
.grid-features-luxe {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-6);
}

.feature-luxe-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}

.feature-luxe-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-accent);
}

.feature-luxe-icon {
  font-size: 40px;
  margin-bottom: var(--space-4);
}

.feature-luxe-title {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-3);
  line-height: var(--leading-snug);
}

.feature-luxe-text {
  font-size: var(--text-sm);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
  margin: 0;
}

/* Packs */
.grid-packs {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-8);
}

/* Timeline 4 étapes */
.timeline-steps {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: var(--space-6);
}

@media (min-width: 768px) {
  .timeline-steps {
    grid-template-columns: repeat(4, 1fr);
  }
}

.step-card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.step-card__num {
  font-family: var(--font-mono);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
