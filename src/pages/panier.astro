---
/**
 * src/pages/panier.astro — Page Panier Ultra-Luxe & Envoi WhatsApp.
 */

import Base from "../layouts/Base.astro";
import Contours from "../components/Contours.astro";
import Crosshair from "../components/Crosshair.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ScrollProgress from "../components/ScrollProgress.astro";

import { site } from "../config/site";
import { getProducts, getPacks } from "../lib/catalog";
import { formatPrice } from "../lib/price";

const products = await getProducts();
const packs = await getPacks();

// Dictionnaire du catalogue transmis au JS client pour hydratation instantanée
const catalogMap: Record<string, {
  type: "produit" | "pack";
  slug: string;
  title: string;
  price?: number;
  cover: string;
  url: string;
}> = {};

products.forEach((p) => {
  catalogMap[`produit:${p.id}`] = {
    type: "produit",
    slug: p.id,
    title: p.data.title,
    price: p.data.price,
    cover: p.data.cover.src,
    url: `/produit/${p.id}`,
  };
});

packs.forEach((p) => {
  catalogMap[`pack:${p.id}`] = {
    type: "pack",
    slug: p.id,
    title: p.data.title,
    price: p.data.price,
    cover: p.data.cover.src,
    url: `/pack/${p.id}`,
  };
});
---

<Base
  title="Mon Panier d'Équipements — GéoTopo Bénin"
  description="Consultez et validez votre panier de matériel topographique. Envoi direct de votre commande par WhatsApp."
>
  <ScrollProgress />
  <Crosshair />

  <!-- Injection des données du catalogue en JSON local -->
  <script type="application/json" id="catalog-data" set:html={JSON.stringify(catalogMap)} />

  <section class="section cart-page">
    <div class="container">
      <Breadcrumbs items={[{ label: "Panier" }]} />

      <div class="cart-header" data-reveal="up">
        <span class="cart-header__eyebrow">COMMANDE & DEVIS EN DIRECT</span>
        <h1 class="cart-header__title">Votre Panier de Matériel Topographique</h1>
        <p class="cart-header__subtitle">
          Vérifiez vos équipements sélectionnés ci-dessous. Votre commande sera transmise directement à notre équipe technique sur WhatsApp (<strong>+229 61 57 27 66</strong>) pour établir votre facture proforma et planifier la remise avec formation offerte.
        </p>
      </div>

      <!-- État Panier Vide -->
      <div class="cart-empty-state" id="cart-empty" style="display: none;">
        <div class="cart-empty-card" data-reveal="up">
          <div class="cart-empty-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="1.5">
              <circle cx="12" cy="12" r="10" stroke-dasharray="4 2"></circle>
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 01-8 0"></path>
            </svg>
          </div>
          <h2 class="cart-empty-title">Votre panier est vide</h2>
          <p class="cart-empty-text">
            Vous n'avez pas encore ajouté de matériel ni de pack d'équipement à votre sélection.
          </p>
          <div class="cart-empty-actions">
            <a href="/boutique" class="btn btn--accent btn--lg">
              🔍 Explorer le catalogue boutique
            </a>
            <a href="/packs" class="btn btn--outline btn--lg">
              📦 Découvrir nos packs brigade
            </a>
          </div>
        </div>
      </div>

      <!-- État Panier Rempli -->
      <div class="cart-content-layout" id="cart-content" style="display: none;">
        <!-- Colonne Gauche : Liste des articles -->
        <div class="cart-items-col">
          <div class="cart-items-header">
            <div class="cart-items-count-badge">
              <span>Articles sélectionnés :</span>
              <strong id="cart-items-badge-num">0</strong>
            </div>
            <button type="button" class="btn-text-danger" id="cart-clear-btn" title="Vider l'ensemble du panier">
              🗑️ Vider le panier
            </button>
          </div>

          <div class="cart-items-list" id="cart-items-list">
            <!-- Injecté en JS avec carte ultra-premium -->
          </div>
        </div>

        <!-- Colonne Droite : Récapitulatif & WhatsApp -->
        <aside class="cart-summary-col">
          <div class="cart-summary-card">
            <h2 class="cart-summary-title">Récapitulatif de commande</h2>

            <div class="cart-summary-lines">
              <div class="summary-line">
                <span>Références distinctes :</span>
                <strong id="sum-items-count">0</strong>
              </div>
              <div class="summary-line">
                <span>Total unités de matériel :</span>
                <strong id="sum-total-qty">0</strong>
              </div>
              <div class="summary-line summary-line--subtotal">
                <span>Sous-total estimé :</span>
                <strong id="sum-subtotal-val" class="summary-subtotal-val">0 FCFA</strong>
              </div>
              <div class="summary-devis-count" id="sum-devis-notice" style="display: none;">
                ⚠️ <span id="devis-count-text">0 article(s) sur devis</span> inclus (montant ajusté après échange).
              </div>
            </div>

            <!-- Champ de Remarques Libre -->
            <div class="cart-notes-group">
              <label for="cart-notes-input" class="cart-notes-label">
                📝 Remarques ou consignes particulières (facultatif) :
              </label>
              <textarea
                id="cart-notes-input"
                class="cart-notes-textarea"
                placeholder="Ex: Demande de proforma officielle, livraison urgente sur chantier à Parakou ou Cotonou, ajout de trépied supplémentaire..."
                rows="3"
              ></textarea>
            </div>

            <!-- Alerte limite de 25 références -->
            <div class="cart-limit-alert" id="cart-limit-alert" style="display: none;">
              ⚠️ Vous avez atteint la limite maximale de 25 références distinctes.
            </div>

            <!-- Bouton WhatsApp Principal -->
            <div class="cart-cta-box">
              <button type="button" class="btn-whatsapp-submit" id="cart-whatsapp-submit">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.764.459 3.48 1.333 4.993l-1.416 5.176 5.297-1.389c1.458.796 3.104 1.216 4.773 1.217h.004c5.505 0 9.988-4.478 9.989-9.985 0-2.668-1.038-5.176-2.924-7.063-1.886-1.887-4.393-2.925-7.066-2.925zm0 1.667c4.586 0 8.322 3.737 8.323 8.322 0 4.586-3.737 8.323-8.324 8.323-1.488 0-2.946-.395-4.223-1.144l-.303-.179-3.137.822.837-3.056-.197-.314a8.275 8.275 0 01-1.298-4.453c0-4.585 3.738-8.321 8.322-8.321z"/>
                </svg>
                <span>Commander sur WhatsApp (+229 61 57 27 66)</span>
              </button>

              <p class="cart-disclaimer">
                🤝 En cliquant sur ce bouton, votre panier sera formaté et transmis directement sur WhatsApp au <strong>+229 61 57 27 66</strong>. Aucun paiement en ligne requis.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
.cart-header {
  margin-block: var(--space-4) var(--space-8);
  max-width: 780px;
}

.cart-header__eyebrow {
  font-family: var(--font-mono, monospace);
  font-size: var(--text-xs, 12px);
  font-weight: 700;
  color: #FF6B00;
  letter-spacing: 0.1em;
}

.cart-header__title {
  font-family: var(--font-serif, Georgia, serif);
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #FFFFFF;
  margin-block: 10px 14px;
}

.cart-header__subtitle {
  font-size: var(--text-base, 1rem);
  color: #E2E8F0;
  line-height: 1.7;
}

.cart-header__subtitle strong {
  color: #FF6B00;
}

/* Empty State */
.cart-empty-card {
  background: rgba(18, 24, 38, 0.8);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 20px;
  padding: 60px 24px;
  text-align: center;
  max-width: 620px;
  margin: 40px auto;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
}

.cart-empty-icon {
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}

.cart-empty-title {
  font-family: var(--font-serif);
  font-size: 1.8rem;
  color: #FFFFFF;
  margin-bottom: 12px;
}

.cart-empty-text {
  font-size: 1rem;
  color: #CBD5E1;
  margin-bottom: 28px;
}

.cart-empty-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  justify-content: center;
}

/* Filled Layout */
.cart-content-layout {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 32px;
  align-items: start;
  margin-bottom: 80px;
}

@media (max-width: 1024px) {
  .cart-content-layout {
    grid-template-columns: 1fr;
  }
}

.cart-items-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  margin-bottom: 24px;
}

.cart-items-count-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono, monospace);
  font-size: 13px;
  color: #94A3B8;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cart-items-count-badge strong {
  background: rgba(255, 107, 0, 0.15);
  border: 1px solid rgba(255, 107, 0, 0.3);
  color: #FF6B00;
  padding: 2px 10px;
  border-radius: 20px;
}

.btn-text-danger {
  background: none;
  border: none;
  color: #FF4D4D;
  font-size: 13px;
  font-family: var(--font-sans);
  font-weight: 600;
  cursor: pointer;
  padding: 6px 12px;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.btn-text-danger:hover {
  background-color: rgba(255, 77, 77, 0.15);
  color: #FF6666;
}

.cart-items-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Carte d'élément Panier Ultra-Luxe */
.cart-item-card {
  display: grid;
  grid-template-columns: 100px 1fr auto auto auto;
  gap: 20px;
  align-items: center;
  background: rgba(18, 24, 38, 0.85);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
  padding: 20px;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}

.cart-item-card:hover {
  border-color: rgba(255, 107, 0, 0.4);
  box-shadow: 0 8px 30px rgba(255, 107, 0, 0.1);
  background: rgba(22, 30, 48, 0.95);
}

@media (max-width: 768px) {
  .cart-item-card {
    grid-template-columns: 80px 1fr auto;
    grid-template-areas:
      "img info remove"
      "controls controls controls";
    gap: 16px;
    padding: 16px;
  }
  .cart-item-img {
    grid-area: img;
  }
  .cart-item-info {
    grid-area: info;
  }
  .btn-remove-item {
    grid-area: remove;
    justify-self: end;
  }
  .cart-item-mobile-row {
    grid-area: controls;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: 14px;
    border-top: 1px dashed rgba(255, 255, 255, 0.1);
  }
}

.cart-item-img {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background-color: #0B0E14;
}

.cart-item-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.cart-item-badge {
  align-self: flex-start;
  font-family: var(--font-mono, monospace);
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
  text-transform: uppercase;
}

.cart-item-badge--produit {
  background: rgba(0, 229, 255, 0.15);
  color: #00E5FF;
  border: 1px solid rgba(0, 229, 255, 0.3);
}

.cart-item-badge--pack {
  background: rgba(255, 107, 0, 0.15);
  color: #FF6B00;
  border: 1px solid rgba(255, 107, 0, 0.3);
}

.cart-item-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 700;
  color: #FFFFFF;
  text-decoration: none;
  line-height: 1.35;
  transition: color 0.2s ease;
}

.cart-item-title:hover {
  color: #FF6B00;
}

.cart-item-unit-price {
  font-family: var(--font-mono, monospace);
  font-size: 13px;
  color: #94A3B8;
}

/* Contrôle de Quantité Réactif & Ergonomique */
.cart-item-qty-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.cart-item-qty-label {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #64748B;
  text-transform: uppercase;
}

.cart-item-qty-control {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  background: rgba(11, 14, 20, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 12px;
  padding: 3px;
}

.qty-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
  border-radius: 8px;
  transition: all 0.2s ease;
  user-select: none;
}

.qty-btn:hover {
  background: #FF6B00;
  color: #FFFFFF;
  border-color: #FF6B00;
  box-shadow: 0 0 12px rgba(255, 107, 0, 0.4);
}

.qty-input {
  width: 46px;
  text-align: center;
  background: transparent;
  border: none;
  color: #FFFFFF;
  font-family: var(--font-mono, monospace);
  font-size: 16px;
  font-weight: 800;
  -moz-appearance: textfield;
}

.qty-input::-webkit-outer-spin-button,
.qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* Total de ligne */
.cart-item-line-total {
  text-align: right;
  min-width: 140px;
}

.line-total-label {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #64748B;
  text-transform: uppercase;
  display: block;
}

.line-total-val {
  display: block;
  font-family: var(--font-mono, monospace);
  font-size: 1.1rem;
  font-weight: 800;
  color: #FFFFFF;
}

.line-total-val.is-devis {
  color: #00E5FF;
}

.btn-remove-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: rgba(255, 77, 77, 0.1);
  border: 1px solid rgba(255, 77, 77, 0.2);
  color: #FF4D4D;
  font-size: 16px;
  cursor: pointer;
  border-radius: 10px;
  transition: all 0.2s ease;
}

.btn-remove-item:hover {
  background: #FF4D4D;
  color: #FFFFFF;
  border-color: #FF4D4D;
  box-shadow: 0 0 12px rgba(255, 77, 77, 0.4);
}

/* Summary Card */
.cart-summary-card {
  background: rgba(18, 24, 38, 0.9);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 28px;
  position: sticky;
  top: 100px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
}

.cart-summary-title {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.cart-summary-lines {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 24px;
}

.summary-line {
  display: flex;
  justify-content: space-between;
  font-size: 0.95rem;
  color: #CBD5E1;
}

.summary-line--subtotal {
  padding-top: 16px;
  border-top: 1px dashed rgba(255, 255, 255, 0.15);
  font-size: 1.1rem;
  color: #FFFFFF;
}

.summary-subtotal-val {
  font-family: var(--font-mono, monospace);
  font-size: 1.25rem;
  color: #FF6B00;
  font-weight: 800;
}

.summary-devis-count {
  background: rgba(0, 229, 255, 0.1);
  border: 1px solid rgba(0, 229, 255, 0.3);
  color: #00E5FF;
  padding: 10px 14px;
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.5;
}

.cart-notes-group {
  margin-bottom: 24px;
}

.cart-notes-label {
  display: block;
  font-size: 13px;
  color: #CBD5E1;
  margin-bottom: 8px;
  font-weight: 600;
}

.cart-notes-textarea {
  width: 100%;
  background: #0B0E14;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  padding: 12px;
  color: #FFFFFF;
  font-family: var(--font-sans);
  font-size: 13px;
  resize: vertical;
  transition: border-color 0.2s ease;
}

.cart-notes-textarea:focus {
  outline: none;
  border-color: #FF6B00;
}

.cart-limit-alert {
  background: rgba(255, 77, 77, 0.15);
  border: 1px solid #FF4D4D;
  color: #FF6666;
  padding: 10px;
  border-radius: 10px;
  font-size: 12px;
  margin-bottom: 20px;
}

.btn-whatsapp-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  padding: 18px 24px;
  background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
  color: #FFFFFF;
  font-family: var(--font-sans);
  font-size: 1.05rem;
  font-weight: 700;
  border-radius: 14px;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 8px 25px rgba(37, 211, 102, 0.3);
}

.btn-whatsapp-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(37, 211, 102, 0.45);
  background: linear-gradient(135deg, #28E16D 0%, #15A090 100%);
}

.cart-disclaimer {
  font-size: 12px;
  color: #94A3B8;
  line-height: 1.5;
  margin-top: 14px;
  text-align: center;
}

.cart-disclaimer strong {
  color: #FFFFFF;
}
</style>

<script>
  import { getCart, updateCartQty, removeFromCart, clearCart, MAX_CART_ITEMS } from "../lib/cart";

  function formatPrice(val?: number): string {
    if (val === undefined || val === null) return "Sur devis";
    return val.toLocaleString("fr-FR").replace(/\s/g, " ") + " FCFA";
  }

  function renderCartPage() {
    const rawCatalogData = document.getElementById("catalog-data")?.textContent;
    if (!rawCatalogData) return;

    const catalogMap: Record<string, {
      type: "produit" | "pack";
      slug: string;
      title: string;
      price?: number;
      cover: string;
      url: string;
    }> = JSON.parse(rawCatalogData);

    const cart = getCart();

    const emptyContainer = document.getElementById("cart-empty");
    const contentContainer = document.getElementById("cart-content");
    const listContainer = document.getElementById("cart-items-list");
    const limitAlert = document.getElementById("cart-limit-alert");
    const badgeNum = document.getElementById("cart-items-badge-num");

    if (!emptyContainer || !contentContainer || !listContainer) return;

    if (cart.length === 0) {
      emptyContainer.style.display = "block";
      contentContainer.style.display = "none";
      return;
    }

    emptyContainer.style.display = "none";
    contentContainer.style.display = "grid";

    if (badgeNum) badgeNum.textContent = String(cart.length);

    if (limitAlert) {
      limitAlert.style.display = cart.length >= MAX_CART_ITEMS ? "block" : "none";
    }

    let totalQty = 0;
    let subtotal = 0;
    let devisCount = 0;

    listContainer.innerHTML = "";

    const isMobile = window.innerWidth <= 768;

    cart.forEach((item) => {
      const key = `${item.type}:${item.slug}`;
      const itemData = catalogMap[key];

      if (!itemData) return;

      totalQty += item.qty;
      const isDevis = itemData.price === undefined || itemData.price === null;

      if (isDevis) {
        devisCount += item.qty;
      } else {
        subtotal += itemData.price! * item.qty;
      }

      const card = document.createElement("div");
      card.className = "cart-item-card";

      const formattedUnit = isDevis ? "Sur devis" : formatPrice(itemData.price);
      const formattedTotal = isDevis ? "Sur devis" : formatPrice(itemData.price! * item.qty);

      if (isMobile) {
        card.innerHTML = `
          <img src="${itemData.cover}" alt="${itemData.title}" class="cart-item-img" width="80" height="80" loading="lazy" />
          
          <div class="cart-item-info">
            <span class="cart-item-badge cart-item-badge--${itemData.type}">
              ${itemData.type === "pack" ? "📦 Pack Complete" : "🎯 Équipement"}
            </span>
            <a href="${itemData.url}" class="cart-item-title">${itemData.title}</a>
            <span class="cart-item-unit-price">${formattedUnit} / unité</span>
          </div>

          <button type="button" class="btn-remove-item" data-slug="${item.slug}" data-type="${item.type}" title="Supprimer">
            ✕
          </button>

          <div class="cart-item-mobile-row">
            <div class="cart-item-qty-control">
              <button type="button" class="qty-btn btn-minus" data-slug="${item.slug}" data-type="${item.type}">-</button>
              <input type="number" class="qty-input" value="${item.qty}" min="1" max="99" data-slug="${item.slug}" data-type="${item.type}" aria-label="Quantité" />
              <button type="button" class="qty-btn btn-plus" data-slug="${item.slug}" data-type="${item.type}">+</button>
            </div>

            <div class="cart-item-line-total">
              <span class="line-total-label">Total :</span>
              <span class="line-total-val ${isDevis ? "is-devis" : ""}">${formattedTotal}</span>
            </div>
          </div>
        `;
      } else {
        card.innerHTML = `
          <img src="${itemData.cover}" alt="${itemData.title}" class="cart-item-img" width="100" height="100" loading="lazy" />
          
          <div class="cart-item-info">
            <span class="cart-item-badge cart-item-badge--${itemData.type}">
              ${itemData.type === "pack" ? "📦 Pack Complete" : "🎯 Équipement"}
            </span>
            <a href="${itemData.url}" class="cart-item-title">${itemData.title}</a>
            <span class="cart-item-unit-price">${formattedUnit} / unité</span>
          </div>

          <div class="cart-item-qty-wrapper">
            <span class="cart-item-qty-label">Quantité</span>
            <div class="cart-item-qty-control">
              <button type="button" class="qty-btn btn-minus" data-slug="${item.slug}" data-type="${item.type}">-</button>
              <input type="number" class="qty-input" value="${item.qty}" min="1" max="99" data-slug="${item.slug}" data-type="${item.type}" aria-label="Quantité" />
              <button type="button" class="qty-btn btn-plus" data-slug="${item.slug}" data-type="${item.type}">+</button>
            </div>
          </div>

          <div class="cart-item-line-total">
            <span class="line-total-label">Montant Total</span>
            <span class="line-total-val ${isDevis ? "is-devis" : ""}">${formattedTotal}</span>
          </div>

          <button type="button" class="btn-remove-item" data-slug="${item.slug}" data-type="${item.type}" title="Supprimer de la commande">
            ✕
          </button>
        `;
      }

      listContainer.appendChild(card);
    });

    // Totaux récapitulatif
    const countEl = document.getElementById("sum-items-count");
    const totalQtyEl = document.getElementById("sum-total-qty");
    const subtotalEl = document.getElementById("sum-subtotal-val");
    const devisNotice = document.getElementById("sum-devis-notice");
    const devisText = document.getElementById("devis-count-text");

    if (countEl) countEl.textContent = String(cart.length);
    if (totalQtyEl) totalQtyEl.textContent = String(totalQty);
    if (subtotalEl) subtotalEl.textContent = formatPrice(subtotal);

    if (devisNotice && devisText) {
      if (devisCount > 0) {
        devisNotice.style.display = "block";
        devisText.textContent = `${devisCount} unité(s) sur devis`;
      } else {
        devisNotice.style.display = "none";
      }
    }

    attachCartEventListeners();
  }

  function attachCartEventListeners() {
    document.querySelectorAll(".btn-minus").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const slug = target.dataset.slug!;
        const type = target.dataset.type as "produit" | "pack";
        const cart = getCart();
        const current = cart.find((i) => i.slug === slug && i.type === type);
        if (current) {
          updateCartQty(slug, type, current.qty - 1);
        }
      });
    });

    document.querySelectorAll(".btn-plus").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const slug = target.dataset.slug!;
        const type = target.dataset.type as "produit" | "pack";
        const cart = getCart();
        const current = cart.find((i) => i.slug === slug && i.type === type);
        if (current) {
          updateCartQty(slug, type, current.qty + 1);
        }
      });
    });

    document.querySelectorAll(".qty-input").forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        const slug = target.dataset.slug!;
        const type = target.dataset.type as "produit" | "pack";
        const val = parseInt(target.value, 10);
        if (!isNaN(val) && val > 0) {
          updateCartQty(slug, type, val);
        } else {
          updateCartQty(slug, type, 1);
        }
      });
    });

    document.querySelectorAll(".btn-remove-item").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const slug = target.dataset.slug!;
        const type = target.dataset.type as "produit" | "pack";
        removeFromCart(slug, type);
      });
    });
  }

  document.getElementById("cart-clear-btn")?.addEventListener("click", () => {
    if (confirm("Êtes-vous sûr de vouloir vider l'ensemble de votre panier ?")) {
      clearCart();
    }
  });

  // Envoi WhatsApp avec le numéro officiel +22961572766
  document.getElementById("cart-whatsapp-submit")?.addEventListener("click", () => {
    const rawCatalogData = document.getElementById("catalog-data")?.textContent;
    if (!rawCatalogData) return;

    const catalogMap: Record<string, any> = JSON.parse(rawCatalogData);
    const cart = getCart();

    if (cart.length === 0) return;

    let totalSubtotal = 0;
    let hasDevisItems = false;

    const lines = cart.map((item) => {
      const key = `${item.type}:${item.slug}`;
      const data = catalogMap[key];
      if (!data) return `- ${item.qty} × ${item.slug}`;

      if (data.price !== undefined && data.price !== null) {
        totalSubtotal += data.price * item.qty;
        return `- ${item.qty} × ${data.title} — ${formatPrice(data.price * item.qty)}`;
      } else {
        hasDevisItems = true;
        return `- ${item.qty} × ${data.title} — Sur devis`;
      }
    });

    const notesInput = (document.getElementById("cart-notes-input") as HTMLTextAreaElement)?.value.trim();

    let message = `Bonjour GéoTopo Bénin, je souhaite passer commande des équipements suivants :\n\n`;
    message += lines.join("\n");
    message += `\n\nTotal indicatif ${hasDevisItems ? "(hors articles sur devis)" : ""} : ${formatPrice(totalSubtotal)}`;

    if (notesInput) {
      message += `\n\nConsignes / Remarques : ${notesInput}`;
    }

    const waUrl = `https://wa.me/22961572766?text=${encodeURIComponent(message)}`;
    window.open(waUrl, "_blank");
  });

  document.addEventListener("DOMContentLoaded", renderCartPage);
  document.addEventListener("astro:page-load", renderCartPage);
  window.addEventListener("panier-mis-a-jour", renderCartPage);
  window.addEventListener("resize", renderCartPage);
</script>
