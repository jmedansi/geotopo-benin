---
/**
 * contact.astro — Page de Contact & Situation Géographique.
 * Conforme à la spec PROMPT 6 du guide.
 */

import Base from "../layouts/Base.astro";
import Contours from "../components/Contours.astro";
import Crosshair from "../components/Crosshair.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ScrollProgress from "../components/ScrollProgress.astro";

import { site } from "../config/site";
import { waLink } from "../lib/whatsapp";

// Calcul de l'état d'ouverture en direct (Timezone Africa/Porto-Novo UTC+1)
const now = new Date();
const options: Intl.DateTimeFormatOptions = {
  timeZone: "Africa/Porto-Novo",
  hour: "numeric",
  minute: "numeric",
  weekday: "short",
  hour12: false,
};

const formatter = new Intl.DateTimeFormat("fr-FR", options);
const parts = formatter.formatToParts(now);

let dayStr = "";
let hourNum = 0;

parts.forEach((p) => {
  if (p.type === "weekday") dayStr = p.value.toLowerCase();
  if (p.type === "hour") hourNum = parseInt(p.value, 10);
});

// Du lundi (lun.) au samedi (sam.), de 8h à 18h
const isSunday = dayStr.includes("dim");
const isOpen = !isSunday && hourNum >= 8 && hourNum < 18;

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;
---

<Base
  title="Contact & Localisation de la Boutique"
  description="Contactez nos géomètres conseils à Cotonou. Adresse, horaires, numéro WhatsApp et conseils d'itinéraire."
>
  <ScrollProgress />
  <Crosshair />

  <!-- Hero Contact -->
  <section class="contact-hero" data-crosshair>
    <Contours variant="hero" draw={true} />
    <div class="container contact-hero__inner">
      <Breadcrumbs items={[{ label: "Contact" }]} />
      <span class="contact-hero__eyebrow">NOUS RENCONTRER À COTONOU</span>
      <h1 class="contact-hero__title" data-reveal="up">
        Contact & Magasin
      </h1>
      <p class="contact-hero__subtitle" data-reveal="up" data-reveal-delay="100">
        Nos techniciens et géomètres conseils vous accueillent pour des démonstrations, des remises de coffrets et des sessions de prise en main.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Badge statut d'ouverture en direct -->
      <div class="opening-status-bar" data-reveal="up">
        {isOpen ? (
          <span class="status-badge status-badge--open">
            <span class="status-dot"></span>
            🟢 Magasin actuellement OUVERT — Nos conseillers vous répondent à Cotonou ({site.hours})
          </span>
        ) : (
          <span class="status-badge status-badge--closed">
            <span class="status-dot"></span>
            🔴 Magasin actuellement FERMÉ — Réouverture à 8h (WhatsApp disponible 24/7 pour vos messages)
          </span>
        )}
      </div>

      <div class="contact-grid">
        <!-- Cartes d'Information Contact -->
        <div class="contact-cards-col" data-reveal="up">
          <div class="contact-card">
            <div class="contact-card__icon">💬</div>
            <div class="contact-card__content">
              <h3 class="contact-card__title">WhatsApp Direct (Prioritaire)</h3>
              <p class="contact-card__text">
                Pour toute question technique, commande de devis ou disponibilité des pièces en boutique.
              </p>
              <a href={waLink(site.messages.contact)} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--md" style="margin-top: var(--space-3);">
                Discuter sur WhatsApp ({site.whatsapp})
              </a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">📍</div>
            <div class="contact-card__content">
              <h3 class="contact-card__title">Adresse du Magasin</h3>
              <p class="contact-card__text">
                {site.address}
              </p>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline btn--sm" style="margin-top: var(--space-3);">
                🗺️ Voir l'itinéraire Google Maps
              </a>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon">📞</div>
            <div class="contact-card__content">
              <h3 class="contact-card__title">Téléphone & Horaires</h3>
              <p class="contact-card__text">
                Ligne directe : <strong>{site.phone}</strong><br />
                Ouverture : {site.hours}
              </p>
            </div>
          </div>
        </div>

        <!-- Carte Stylisée / Cadre Visuel -->
        <div class="contact-map-col" data-reveal="up" data-reveal-delay="150">
          <div class="map-card-frame">
            <div class="map-placeholder">
              <div class="map-crosshair-graphic">
                <svg width="120" height="120" viewBox="0 0 100 100" fill="none">
                  <circle cx="50" cy="50" r="45" stroke="var(--color-accent)" stroke-width="1" stroke-dasharray="6 3"/>
                  <circle cx="50" cy="50" r="25" stroke="var(--color-cyan)" stroke-width="1"/>
                  <line x1="50" y1="0" x2="50" y2="100" stroke="var(--color-accent)" stroke-width="1"/>
                  <line x1="0" y1="50" x2="100" y2="50" stroke="var(--color-accent)" stroke-width="1"/>
                  <circle cx="50" cy="50" r="4" fill="var(--color-accent)"/>
                </svg>
              </div>
              <h3 class="map-placeholder__title">Boutique & Atelier GéoTopo Bénin</h3>
              <p class="map-placeholder__sub">{site.address}</p>
              
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn--accent btn--lg">
                🚀 Ouvrir dans Google Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.contact-hero {
  position: relative;
  background-color: var(--color-bg-alt);
  color: #FFFFFF;
  padding-block: var(--space-16);
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}

.contact-hero__inner {
  position: relative;
  z-index: 2;
}


.contact-hero__eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  letter-spacing: var(--tracking-widest);
}

.contact-hero__title {
  font-family: var(--font-serif);
  font-size: var(--text-4xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-block: var(--space-3);
}

.contact-hero__subtitle {
  font-size: var(--text-lg);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
}

.opening-status-bar {
  margin-block: var(--space-6) var(--space-8);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-full);
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
}

.status-badge--open {
  background-color: rgba(37, 211, 102, 0.15);
  color: #25D366;
  border: 1px solid rgba(37, 211, 102, 0.4);
}

.status-badge--closed {
  background-color: rgba(255, 77, 77, 0.15);
  color: #FF4D4D;
  border: 1px solid rgba(255, 77, 77, 0.4);
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
  align-items: stretch;
}

@media (max-width: 900px) {
  .contact-grid {
    grid-template-columns: 1fr;
  }
}

.contact-cards-col {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.contact-card {
  display: flex;
  gap: var(--space-4);
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.contact-card__icon {
  font-size: 32px;
  flex-shrink: 0;
}

.contact-card__title {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-1);
}

.contact-card__text {
  font-size: var(--text-sm);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
  margin: 0;
}

.contact-map-col {
  height: 100%;
  min-height: 400px;
}

.map-card-frame {
  height: 100%;
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--space-8);
  z-index: 2;
}

.map-crosshair-graphic {
  margin-bottom: var(--space-4);
}

.map-placeholder__title {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-1);
}

.map-placeholder__sub {
  font-size: var(--text-sm);
  color: #E2E8F0;
  margin-bottom: var(--space-6);
}
</style>
