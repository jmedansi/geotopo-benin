---
/**
 * index.astro — Page d'Accueil Ultra-Premium GéoTopo Bénin
 * Design e-commerce mondial · Copywriting d'élite · Animations Pro
 */

import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProductCard from "../components/ProductCard.astro";
import PackCard from "../components/PackCard.astro";
import Accordion from "../components/Accordion.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import ScrollProgress from "../components/ScrollProgress.astro";

import { site } from "../config/site";
import { getFeaturedProducts, getPacks, getProducts } from "../lib/catalog";

const featuredProducts = await getFeaturedProducts(6);
const packs = await getPacks();
const allProducts = await getProducts();

const metierProducts = {
  geomètres: allProducts.filter(p => ["stations-totales","gnss-gps"].includes(p.data.category)).slice(0,3),
  btp: allProducts.filter(p => ["niveaux","lasers-distancemetres"].includes(p.data.category)).slice(0,3),
  drones: allProducts.filter(p => p.data.category === "drones-scanners").slice(0,3),
};

const homeFaq = [
  { q: "Êtes-vous un importateur agréé ou une boutique classique ?", a: "GéoTopo Bénin est l'importateur direct et distributeur exclusif de marques comme FOIF, Leica Geosystems, CHCNAV et South en Afrique de l'Ouest. Nos appareils arrivent directement des usines sans aucun intermédiaire, ce qui garantit leur authenticité et un tarif sans spéculation." },
  { q: "Comment se passe la commande et le règlement ?", a: "Tout se fait sur WhatsApp — aucun paiement en ligne. Vous nous décrivez votre besoin ou envoyez votre panier. On vous envoie une facture proforma officielle. L'acompte est réglé au démarrage et le solde à la livraison, après que vous ayez vérifié le matériel en main propre." },
  { q: "Le matériel est-il contrôlé avant livraison ?", a: "Absolument. Chaque instrument passe par notre banc d'étalonnage géodésique à Cotonou. Nous testons les angles, la distance, le centrage et le calage. Vous recevez un certificat de contrôle daté avec les tolérances mesurées." },
  { q: "Livrez-vous dans d'autres pays d'Afrique francophone ?", a: "Oui. Nous expédions régulièrement au Togo, au Niger, au Burkina Faso, en Côte d'Ivoire, au Cameroun, au Mali et en Guinée. Le transit douanier est entièrement géré par nos soins." },
  { q: "Y a-t-il une formation à la livraison ?", a: "Chaque coffret livré inclut une demi-journée de prise en main pratique offerte à votre brigade, dans nos locaux à Cotonou ou sur votre chantier. Nos techniciens assurent également le SAV sur WhatsApp après livraison." },
];

const testimonials = [
  { author: "Ing. Martial DOSSOU", role: "Géomètre-Expert Agréé", location: "Cabinet GéoCadastre · Cotonou", avatar: "M", stars: 5, text: "La Station ST-M5 est arrivée étalonnée, prête à mesurer. Le certificat de contrôle inspire vraiment confiance. On travaille avec GéoTopo depuis 2 ans — fiabilité totale." },
  { author: "Dr. Hippolyte KOUAGOU", role: "Directeur BTP & Infrastructures", location: "Société TPRO · Parakou & Niamey", avatar: "H", stars: 5, text: "Enfin un fournisseur qui gère tout : le sourcing, le transit, le dédouanement, la formation. Nos chantiers ne s'arrêtent plus pour des problèmes matériels." },
  { author: "Clarisse ADANGBÉ", role: "Ingénieure SIG & Foncier", location: "BET Aménagement · Porto-Novo & Lomé", avatar: "C", stars: 5, text: "Le Pack Brigade RTK est exceptionnel. Le setup GNSS/Drone est parfaitement compatible avec Covadis et QGIS. La brigade est opérationnelle dès J+1." },
];
---

<Base title={`${site.name} — Importateur Direct d'Équipements Topographiques`} description={site.description}>
  <ScrollProgress />

  <!-- ═══════════════════════════════════════════════════════════
       HERO CINÉMATIQUE PLEIN ÉCRAN
       ═══════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <!-- Image de fond cinématique -->
    <div class="hero__bg">
      <img src="/hero-bg.jpg" alt="" role="presentation" class="hero__bg-img" />
      <div class="hero__bg-overlay"></div>
      <!-- Grille animée -->
      <div class="hero__grid" aria-hidden="true"></div>
    </div>

    <!-- Contenu Hero -->
    <div class="container">
      <div class="hero__text">
        <!-- Chips d'autorité -->
        <div class="hero__chips" data-anim="fade-up" style="--delay:0s">
          <span class="chip chip--orange">🏭 Importateur Direct Usine</span>
          <span class="chip chip--cyan">🎯 Étalonnage Géodésique à Cotonou</span>
          <span class="chip chip--white">🌍 7 Pays en Afrique Francophone</span>
        </div>

        <h1 class="hero__title" data-anim="fade-up" style="--delay:.12s">
          L'Équipement Topo <span class="hero__title-accent">de Précision Mondiale</span> <span class="hero__title-sub">Livré au Bénin & en Afrique.</span>
        </h1>

        <p class="hero__subtitle" data-anim="fade-up" style="--delay:.24s">
          Nous importons directement depuis les usines <strong>FOIF, Leica, South, CHCNAV & DJI</strong> pour
          vous livrer le matériel authentique, étalonné et garanti — sans intermédiaire, sans surprise.
        </p>

        <!-- CTA Buttons -->
        <div class="hero__cta-row" data-anim="fade-up" style="--delay:.36s">
          <a href="/boutique" class="btn-hero btn-hero--primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            Voir le Catalogue
          </a>
          <WhatsAppButton message={site.messages.advisor} label="Parler à un Expert" variant="whatsapp" size="lg" />
        </div>

        <!-- Trust bar mini -->
        <div class="hero__trust" data-anim="fade-up" style="--delay:.48s">
          <div class="trust-pill">🛡️ Garantie 1 an</div>
          <div class="trust-sep"></div>
          <div class="trust-pill">🎓 Formation offerte</div>
          <div class="trust-sep"></div>
          <div class="trust-pill">📦 Prix constructeur</div>
          <div class="trust-sep"></div>
          <div class="trust-pill">✈️ Fret & douanes inclus</div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <a href="#stats" class="hero__scroll-ind" aria-label="Défiler">
      <span>Défiler</span>
      <div class="scroll-ind-line"></div>
    </a>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       BARRE DE MARQUES PARTENAIRES
       ═══════════════════════════════════════════════════════════ -->
  <section class="brands-bar">
    <div class="brands-bar__label">Marques officielles importées</div>
    <div class="brands-marquee">
      <div class="brands-track">
        {[...site.brands, ...site.brands].map(b => (
          <span class="brand-item">{b}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 2 : CHIFFRES D'IMPACT
       ═══════════════════════════════════════════════════════════ -->
  <section class="section stats-section" id="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item" data-anim="fade-up" style="--delay:0s">
          <div class="stat-num" data-count="18">0</div>
          <div class="stat-suffix">+ références</div>
          <div class="stat-label">d'équipements certifiés usine en catalogue</div>
        </div>
        <div class="stat-item" data-anim="fade-up" style="--delay:.1s">
          <div class="stat-num" data-count="100">0</div>
          <div class="stat-suffix">% des appareils</div>
          <div class="stat-label">étalonnés sur base géodésique à Cotonou</div>
        </div>
        <div class="stat-item" data-anim="fade-up" style="--delay:.2s">
          <div class="stat-num" data-count="7">0</div>
          <div class="stat-suffix">pays d'Afrique</div>
          <div class="stat-label">desservis en Afrique Francophone</div>
        </div>
        <div class="stat-item" data-anim="fade-up" style="--delay:.3s">
          <div class="stat-num" data-count="1">0</div>
          <div class="stat-suffix">an de garantie</div>
          <div class="stat-label">avec SAV local assuré à Cotonou</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 3 : PRODUITS VEDETTES
       ═══════════════════════════════════════════════════════════ -->
  <section class="section" id="produits">
    <div class="container">
      <SectionHeading
        eyebrow="SÉLECTION TERRAIN"
        title="Équipements les plus demandés"
        subtitle="Les références plébiscitées par les géomètres-experts, cabinets BTP et brigades sur chantier."
      />
      <div class="product-grid" data-stagger="0.07">
        {featuredProducts.map(prod => <ProductCard product={prod} />)}
      </div>
      <div class="section__cta-center" data-anim="fade-up" style="--delay:.2s">
        <a href="/boutique" class="btn-outline-glow">
          Explorer les 18 équipements du catalogue &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 4 : SPLIT VISUAL — L'AVANTAGE IMPORTATEUR
       ═══════════════════════════════════════════════════════════ -->
  <section class="section split-section" id="avantages">
    <div class="container split-section__inner">
      <!-- Colonne visuelle (image) -->
      <div class="split-visual" data-anim="fade-right" style="--delay:0s">
        <div class="split-visual__frame">
          <img src="/atelier-etalonnage.jpg" alt="Atelier d'étalonnage GéoTopo Bénin à Cotonou" class="split-visual__img" />
          <div class="split-visual__badge">
            <span class="badge-icon">🎯</span>
            <span>Banc d'Étalonnage<br /><strong>Géodésique Certifié</strong></span>
          </div>
        </div>
      </div>

      <!-- Colonne texte -->
      <div class="split-text" data-anim="fade-left" style="--delay:.1s">
        <span class="eyebrow-tag">NOTRE DIFFÉRENCE</span>
        <h2 class="split-text__title">
          Plus qu'un revendeur —<br />
          <em>Votre partenaire métrologique.</em>
        </h2>
        <p class="split-text__lead">
          Quand vous commandez chez GéoTopo Bénin, vous n'achetez pas un appareil dans un carton. Vous investissez dans une chaîne de valeur complète.
        </p>

        <div class="advantage-list">
          <div class="adv-item">
            <div class="adv-icon">🏭</div>
            <div>
              <strong>Importation directe usine · zéro intermédiaire</strong>
              <p>Nous achetons aux sièges constructeurs FOIF, Leica, South, CHCNAV, Sokkia et DJI. Résultat : prix compétitifs et traçabilité totale des numéros de série.</p>
            </div>
          </div>
          <div class="adv-item">
            <div class="adv-icon">🔬</div>
            <div>
              <strong>Protocole de contrôle métrologique rigoureux</strong>
              <p>Chaque instrument passe 48h en atelier à Cotonou. Vérification de la précision angulaire, distancemétrique et du centrage sur base géodésique.</p>
            </div>
          </div>
          <div class="adv-item">
            <div class="adv-icon">🛡️</div>
            <div>
              <strong>Garantie 1 an & SAV local réactif sous 48h</strong>
              <p>Pièces de rechange en stock, techniciens qualifiés sur place, assistance WhatsApp permanente. Votre investissement est protégé.</p>
            </div>
          </div>
          <div class="adv-item">
            <div class="adv-icon">🎓</div>
            <div>
              <strong>Formation pratique de 1/2 journée offerte</strong>
              <p>Mise en station, paramétrage carnet, export de données : votre brigade est formée avant de quitter nos locaux.</p>
            </div>
          </div>
        </div>

        <a href="/sur-mesure" class="btn-accent-solid">
          Demander une commande sur-mesure &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 5 : PACKS CLÉ EN MAIN
       ═══════════════════════════════════════════════════════════ -->
  <section class="section section--alt" id="packs">
    <div class="container">
      <SectionHeading
        eyebrow="KITS TERRAIN PRÊTS À MESURER"
        title="Packs complets pour brigades"
        subtitle="Chaque pack est assemblé par nos géomètres : compatibilité 100% garantie, tarif préférentiel, formation offerte."
      />
      <div class="packs-grid" data-stagger="0.1">
        {packs.map(p => (
          <PackCard pack={p} productNames={["Station Total", "Trépied", "Mire"]} />
        ))}
      </div>
      <div class="section__cta-center" data-anim="fade-up" style="--delay:.2s">
        <a href="/packs" class="btn-outline-glow">Voir tous nos packs &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 6 : COMMENT COMMANDER (PROCESS VISUEL)
       ═══════════════════════════════════════════════════════════ -->
  <section class="section process-section" id="process">
    <div class="container">
      <SectionHeading
        eyebrow="PROCESSUS TRANSPARENT"
        title="De la commande à la mise en station"
        subtitle="4 étapes simples. Un seul numéro WhatsApp. Aucune mauvaise surprise."
      />

      <div class="process-grid">
        <div class="process-step" data-anim="fade-up" style="--delay:0s">
          <div class="process-step__num">01</div>
          <div class="process-step__icon">💬</div>
          <h3>Discutez sur WhatsApp</h3>
          <p>Décrivez votre besoin ou envoyez votre panier. Un géomètre-conseil vous répond sous 2h.</p>
        </div>
        <div class="process-connector" aria-hidden="true">→</div>
        <div class="process-step" data-anim="fade-up" style="--delay:.1s">
          <div class="process-step__num">02</div>
          <div class="process-step__icon">📋</div>
          <h3>Proforma & Importation</h3>
          <p>Vous recevez une facture proforma officielle. On lance le sourcing direct usine immédiatement.</p>
        </div>
        <div class="process-connector" aria-hidden="true">→</div>
        <div class="process-step" data-anim="fade-up" style="--delay:.2s">
          <div class="process-step__num">03</div>
          <div class="process-step__icon">🔬</div>
          <h3>Étalonnage à Cotonou</h3>
          <p>À l'arrivée, chaque appareil passe 48h en atelier. Vous recevez un certificat de contrôle.</p>
        </div>
        <div class="process-connector" aria-hidden="true">→</div>
        <div class="process-step" data-anim="fade-up" style="--delay:.3s">
          <div class="process-step__num">04</div>
          <div class="process-step__icon">🚀</div>
          <h3>Remise & Formation</h3>
          <p>Livraison en main propre à Cotonou ou sur votre chantier avec formation terrain offerte.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 7 : SPLIT VISUEL — ÉQUIPE SUR TERRAIN
       ═══════════════════════════════════════════════════════════ -->
  <section class="section section--alt split-section split-section--reverse">
    <div class="container split-section__inner">
      <!-- Texte -->
      <div class="split-text" data-anim="fade-right" style="--delay:0s">
        <span class="eyebrow-tag">RÉSEAU AFRIQUE FRANCOPHONE</span>
        <h2 class="split-text__title">
          Du Bénin au Cameroun,<br />
          <em>nous sommes votre base arrière.</em>
        </h2>
        <p class="split-text__lead">
          Nos clients couvrent 7 pays. Chantier de routes au Niger, campagne cadastrale au Togo, projet SIG en Côte d'Ivoire — nous livrons là où vous travaillez.
        </p>
        <div class="country-grid">
          {["🇧🇯 Bénin","🇹🇬 Togo","🇳🇪 Niger","🇧🇫 Burkina Faso","🇨🇮 Côte d'Ivoire","🇨🇲 Cameroun","🇲🇱 Mali"].map(c => (
            <span class="country-chip">{c}</span>
          ))}
        </div>
        <WhatsAppButton message={site.messages.advisor} label="🌍 Nous contacter pour votre zone" variant="whatsapp" size="lg" />
      </div>

      <!-- Image terrain -->
      <div class="split-visual" data-anim="fade-left" style="--delay:.1s">
        <div class="split-visual__frame">
          <img src="/team-terrain.jpg" alt="Brigade de géomètres africains sur terrain avec équipement topo" class="split-visual__img" />
          <div class="split-visual__badge split-visual__badge--right">
            <span class="badge-icon">🌍</span>
            <span>7 pays<br /><strong>desservis</strong></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 8 : TÉMOIGNAGES
       ═══════════════════════════════════════════════════════════ -->
  <section class="section reviews-section" id="avis">
    <div class="container">
      <SectionHeading
        eyebrow="AVIS CLIENTS VÉRIFIÉS"
        title="La confiance des professionnels"
        subtitle="Des géomètres-experts, ingénieurs BTP et cabinets SIG qui travaillent avec nous depuis des années."
      />
      <div class="reviews-grid">
        {testimonials.map((t, i) => (
          <div class="review-card" data-anim="fade-up" style={`--delay:${i*0.1}s`}>
            <div class="review-stars">{"★".repeat(t.stars)}</div>
            <p class="review-text">"{t.text}"</p>
            <div class="review-author">
              <div class="review-avatar">{t.avatar}</div>
              <div class="review-info">
                <strong>{t.author}</strong>
                <span>{t.role}</span>
                <span class="review-location">📍 {t.location}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 9 : FAQ
       ═══════════════════════════════════════════════════════════ -->
  <section class="section section--alt" id="faq">
    <div class="container container--narrow-lg">
      <SectionHeading
        eyebrow="QUESTIONS FRÉQUENTES"
        title="Tout ce que vous devez savoir"
        subtitle="Des réponses directes sur nos commandes, notre process et nos engagements."
      />
      <Accordion items={homeFaq} />
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 10 : CTA FINAL CINÉMATIQUE
       ═══════════════════════════════════════════════════════════ -->
  <section class="cta-final" id="cta">
    <div class="cta-final__bg">
      <img src="/gnss-rtk.jpg" alt="" role="presentation" class="cta-final__bg-img" />
      <div class="cta-final__overlay"></div>
    </div>
    <div class="container cta-final__content" data-anim="fade-up" style="--delay:0s">
      <span class="eyebrow-tag eyebrow-tag--light">COMMANDES SUR-MESURE & SOURCING</span>
      <h2 class="cta-final__title">
        Vous ne trouvez pas<br />la référence exacte ?
      </h2>
      <p class="cta-final__subtitle">
        Nos ingénieurs acheteurs se chargent de sourcer et d'importer n'importe quel modèle de matériel topographique dans le monde entier. Proforma sous 24h.
      </p>
      <div class="cta-final__actions">
        <a href="/sur-mesure" class="btn-hero btn-hero--primary">
          📝 Formulaire Sur-Mesure
        </a>
        <WhatsAppButton message={site.messages.surMesure} label="💬 Écrire au service Importation" variant="whatsapp" size="lg" />
      </div>
    </div>
  </section>

</Base>

<style>
/* ═══════════════════════════════════════
   HERO
   ═══════════════════════════════════════ */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding-top: calc(var(--header-height) + 40px);
  padding-bottom: 100px;
}

.hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 70% center;
}

.hero__bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    rgba(11,14,20,.97) 0%,
    rgba(11,14,20,.88) 45%,
    rgba(11,14,20,.45) 75%,
    rgba(11,14,20,.2) 100%
  );
}

/* Grille animée Topographique */
.hero__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,107,0,.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,107,0,.06) 1px, transparent 1px);
  background-size: 60px 60px;
  animation: gridScroll 20s linear infinite;
}

@keyframes gridScroll {
  from { background-position: 0 0; }
  to   { background-position: 60px 60px; }
}

/* Le container gère déjà padding-inline.
   hero__text est LEFT-aligné (pas de margin-inline: auto)
   avec une contrainte de largeur pour ne pas étaler le texte sur 100% */
.hero__text {
  position: relative;
  z-index: 2;
  max-width: 680px;
}


/* Animation data-anim */
[data-anim] {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity .7s ease, transform .7s ease;
  transition-delay: var(--delay, 0s);
}
[data-anim="fade-right"] {
  transform: translateX(-28px);
}
[data-anim="fade-left"] {
  transform: translateX(28px);
}
[data-anim].visible {
  opacity: 1;
  transform: none;
}

/* Chips Hero */
.hero__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 28px;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 100px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .04em;
}

.chip--orange {
  background: rgba(255,107,0,.18);
  border: 1px solid rgba(255,107,0,.5);
  color: #FF6B00;
}
.chip--cyan {
  background: rgba(0,229,255,.12);
  border: 1px solid rgba(0,229,255,.4);
  color: #00E5FF;
}
.chip--white {
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.25);
  color: #FFFFFF;
}

/* Titre Hero */
.hero__title {
  font-family: var(--font-serif);
  font-size: clamp(2.4rem, 5.5vw, 4.2rem);
  font-weight: 800;
  line-height: 1.1;
  color: #FFFFFF;
  margin-bottom: 24px;
}

.hero__title-accent {
  background: linear-gradient(90deg, #FF6B00 0%, #FFB347 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero__title-sub {
  display: block;
