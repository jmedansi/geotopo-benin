---
/**
 * 404.astro — Page d'Erreur 404 Topographique Ultra-Luxe.
 * Conforme à la spec PROMPT 6 du guide.
 */

import Base from "../layouts/Base.astro";
import Contours from "../components/Contours.astro";
import Crosshair from "../components/Crosshair.astro";
import ScrollProgress from "../components/ScrollProgress.astro";

import { site } from "../config/site";
import { waLink } from "../lib/whatsapp";
---

<Base
  title="404 — Hors Périmètre Topographique"
  description="La page ou la coordonnée demandée est introuvable."
>
  <ScrollProgress />
  <Crosshair />

  <section class="section error-page" data-crosshair>
    <Contours variant="hero" draw={true} />

    <div class="container error-page__inner">
      <div class="error-visual" data-reveal="scale">
        <svg width="140" height="140" viewBox="0 0 120 120" fill="none" class="error-crosshair-svg">
          <circle cx="60" cy="60" r="54" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="8 4" />
          <circle cx="60" cy="60" r="34" stroke="var(--color-cyan)" stroke-width="1" />
          <line x1="60" y1="0" x2="60" y2="120" stroke="var(--color-accent)" stroke-width="1.5" />
          <line x1="0" y1="60" x2="120" y2="60" stroke="var(--color-accent)" stroke-width="1.5" />
          <path d="M45 45L75 75M75 45L45 75" stroke="#FF4D4D" stroke-width="3" stroke-linecap="round" />
        </svg>
        <span class="error-code">404</span>
      </div>

      <h1 class="error-title" data-reveal="up">
        Hors Périmètre Topographique
      </h1>

      <p class="error-subtitle" data-reveal="up" data-reveal-delay="100">
        Les coordonnées pointées par votre navigateur ne correspondent à aucun repère valide sur le réseau GéoTopo Bénin. La fiche a peut-être été déplacée ou archivée.
      </p>

      <div class="error-actions" data-reveal="up" data-reveal-delay="200">
        <a href="/" class="btn btn--accent btn--lg">
          🏠 Retour à l'accueil
        </a>
        <a href="/boutique" class="btn btn--outline btn--lg">
          🔍 Explorer la boutique
        </a>
        <a href={waLink("Bonjour, je cherchais une page sur votre site qui est introuvable.")} target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--lg">
          💬 Signaler sur WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
.error-page {
  position: relative;
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  padding-block: var(--space-16);
}

.error-page__inner {
  position: relative;
  z-index: 2;
  max-width: 680px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-6);
}

.error-crosshair-svg {
  animation: spin 30s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.error-code {
  position: absolute;
  font-family: var(--font-mono);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  background-color: var(--color-bg);
  padding: 4px 12px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
}

.error-title {
  font-family: var(--font-serif);
  font-size: var(--text-4xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-3);
}

.error-subtitle {
  font-size: var(--text-base);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-8);
}

.error-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  justify-content: center;
}
</style>
