---
/**
 * boutique.astro — Page Boutique avec filtres instantanés, recherche & synchro URL.
 * Conforme à la spec PROMPT 3 du guide.
 */

import Base from "../layouts/Base.astro";
import Contours from "../components/Contours.astro";
import Crosshair from "../components/Crosshair.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProductCard from "../components/ProductCard.astro";
import Lightbox from "../components/Lightbox.astro";
import ScrollProgress from "../components/ScrollProgress.astro";

import { getCategories, getProducts } from "../lib/catalog";

const categories = await getCategories();
const products = await getProducts();
---

<Base title="Boutique & Catalogue" description="Découvrez notre catalogue complet d'équipements de topographie professionnels au Bénin. Recherche, filtres par catégorie et disponibilité.">
  <ScrollProgress />
  <Crosshair />
  <Lightbox />

  <!-- En-tête sombre avec contours -->
  <section class="boutique-hero" data-crosshair>
    <Contours variant="hero" draw={true} />
    <div class="container boutique-hero__inner">
      <span class="boutique-hero__eyebrow">CATALOGUE COMPLET</span>
      <h1 class="boutique-hero__title" data-reveal="up">
        Tous les équipements de topographie
      </h1>
      <p class="boutique-hero__subtitle" data-reveal="up" data-reveal-delay="100">
        Recherchez par mot-clé, filtrez par catégorie ou disponibilité. Tout le matériel est contrôlé à Cotonou et livré sur commande.
      </p>

      <!-- Compteur de résultats dynamique -->
      <div class="boutique-hero__count" data-reveal="up" data-reveal-delay="200">
        <span id="results-count">{products.length}</span> produit(s) disponible(s)
      </div>
    </div>
  </section>

  <!-- Barre de filtres collante et réactive -->
  <section class="section section-boutique">
    <div class="container">
      <div class="filters-bar" id="filters-bar">
        <!-- Recherche textuelle -->
        <div class="filter-group filter-group--search">
          <label for="search-input" class="sr-only">Rechercher un équipement</label>
          <div class="search-input-wrapper">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="search-input"
              class="search-input"
              placeholder="Rechercher (ex: ST-M5, GNSS, Laser, Sokkia...)"
              autocomplete="off"
            />
          </div>
        </div>

        <!-- Pastilles de catégories -->
        <div class="filter-group filter-group--cats" role="radiogroup" aria-label="Catégories">
          <button type="button" class="cat-pill is-active" data-cat="all">
            Toutes les catégories
          </button>
          {categories.map((cat) => (
            <button type="button" class="cat-pill" data-cat={cat.id}>
              {cat.data.title}
            </button>
          ))}
        </div>

        <!-- Filtres secondaires : Disponibilité & Prix -->
        <div class="filter-group filter-group--secondary">
          <!-- Tri -->
          <div class="select-wrapper">
            <label for="sort-select" class="sr-only">Trier par</label>
            <select id="sort-select" class="filter-select">
              <option value="default">Tri par pertinence</option>
              <option value="price-asc">Prix croissant</option>
              <option value="price-desc">Prix décroissant</option>
              <option value="name-asc">Nom (A &rarr; Z)</option>
            </select>
          </div>

          <!-- Filtre Disponibilité -->
          <div class="select-wrapper">
            <label for="dispo-select" class="sr-only">Disponibilité</label>
            <select id="dispo-select" class="filter-select">
              <option value="all">Toutes disponibilités</option>
              <option value="en-boutique">En boutique uniquement</option>
              <option value="sur-commande">Sur commande uniquement</option>
            </select>
          </div>

          <!-- Filtre Prix / Devis -->
          <div class="select-wrapper">
            <label for="price-mode-select" class="sr-only">Mode de tarif</label>
            <select id="price-mode-select" class="filter-select">
              <option value="all">Tous les tarifs</option>
              <option value="with-price">Prix affiché FCFA</option>
              <option value="devis">Sur devis uniquement</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Grille de cartes (Lisible même sans JS) -->
      <div class="product-grid" id="boutique-grid" data-stagger="0.06">
        {products.map((p) => (
          <div
            class="boutique-grid-item"
            data-product-id={p.id}
            data-cat={p.data.category}
            data-title={p.data.title.toLowerCase()}
            data-summary={p.data.summary.toLowerCase()}
            data-brand={(p.data.brand || "").toLowerCase()}
            data-availability={p.data.availability}
            data-price={p.data.price ?? 999999999}
            data-has-price={p.data.price !== undefined ? "true" : "false"}
          >
            <ProductCard product={p} />
          </div>
        ))}
      </div>

      <!-- État vide (affiché si 0 résultat après filtrage) -->
      <div class="empty-state" id="empty-state" hidden>
        <div class="empty-state__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3 class="empty-state__title">Aucun équipement ne correspond à votre recherche</h3>
        <p class="empty-state__text">
          Nous pouvons procurer n'importe quelle référence de matériel de topographie sur commande direct usine.
        </p>
        <div style="margin-top: var(--space-6);">
          <a href="/sur-mesure" class="btn btn--primary btn--lg">
            Formuler une demande sur-mesure &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>
</Base>

<style>
.boutique-hero {
  position: relative;
  background-color: var(--color-bg-alt);
  color: #FFFFFF;
  padding-block: var(--space-16);
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}

.boutique-hero__inner {
  position: relative;
  z-index: 2;
  text-align: center;
}


.boutique-hero__eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  letter-spacing: var(--tracking-widest);
}

.boutique-hero__title {
  font-family: var(--font-serif);
  font-size: var(--text-4xl);
  font-weight: var(--weight-bold);
  margin-block: var(--space-3);
  color: #FFFFFF;
}

.boutique-hero__subtitle {
  font-size: var(--text-lg);
  color: #E2E8F0;
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-6);
}

.boutique-hero__count {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--color-laser);
  background-color: rgba(0, 229, 255, 0.1);
  border: 1px solid rgba(0, 229, 255, 0.3);
  padding: 6px 16px;
  border-radius: var(--radius-full);
}

.filters-bar {
  position: sticky;
  top: calc(var(--header-height) + 16px);
  z-index: 90;
  background-color: #121722;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-xl);
  padding: var(--space-4);
  margin-bottom: var(--space-10);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 16px;
  color: var(--color-text-faint);
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 12px 16px 12px 48px;
  background-color: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-md);
  color: #FFFFFF;
  font-size: var(--text-base);
  transition: border-color var(--transition-fast);
}

.search-input:focus {
  outline: none;
  border-color: var(--color-accent);
}

.filter-group--cats {
  display: flex;
  gap: var(--space-2);
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: none;
}

.filter-group--cats::-webkit-scrollbar {
  display: none;
}

.cat-pill {
  padding: 6px 14px;
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: #E2E8F0;
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  white-space: nowrap;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.cat-pill:hover {
  background-color: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
}

.cat-pill.is-active {
  background-color: var(--color-accent);
  color: #FFFFFF;
  border-color: var(--color-accent);
  box-shadow: 0 2px 10px rgba(255, 107, 0, 0.4);
}

.filter-group--secondary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: var(--space-3);
}

.filter-select {
  width: 100%;
  padding: 10px 14px;
  background-color: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-md);
  color: #FFFFFF;
  font-size: var(--text-sm);
  cursor: pointer;
}

.empty-state {
  text-align: center;
  padding-block: var(--space-16);
  max-width: 540px;
  margin-inline: auto;
}

.empty-state[hidden] {
  display: none !important;
}

.empty-state__icon {
  margin-bottom: var(--space-4);
}

.empty-state__title {
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  margin-bottom: var(--space-2);
}

.empty-state__text {
  font-size: var(--text-base);
  color: #E2E8F0;
}
</style>

<script>
/**
 * Filtrage instantané, tri et synchronisation URL (searchParams).
 */
function initBoutiqueFilters() {
  const searchInput     = document.getElementById("search-input") as HTMLInputElement | null;
  const sortSelect      = document.getElementById("sort-select") as HTMLSelectElement | null;
  const dispoSelect     = document.getElementById("dispo-select") as HTMLSelectElement | null;
  const priceModeSelect = document.getElementById("price-mode-select") as HTMLSelectElement | null;
  const catPills        = document.querySelectorAll<HTMLButtonElement>(".cat-pill");
  const items           = document.querySelectorAll<HTMLElement>(".boutique-grid-item");
  const countEl         = document.getElementById("results-count");
  const emptyState      = document.getElementById("empty-state");
  const grid            = document.getElementById("boutique-grid");

  if (!items.length) return;

  let activeCat = "all";

  // Lecture des paramètres URL initiaux
  const params = new URLSearchParams(window.location.search);
  const qParam = params.get("q") || "";
  const catParam = params.get("cat") || "all";
  const triParam = params.get("tri") || "default";
  const dispoParam = params.get("dispo") || "all";
  const prixParam = params.get("prix") || "all";

  if (searchInput && qParam) searchInput.value = qParam;
  if (sortSelect && triParam) sortSelect.value = triParam;
  if (dispoSelect && dispoParam) dispoSelect.value = dispoParam;
  if (priceModeSelect && prixParam) priceModeSelect.value = prixParam;

  if (catParam !== "all") {
    activeCat = catParam;
    catPills.forEach((p) => {
      p.classList.toggle("is-active", p.dataset.cat === catParam);
    });
  }

  function updateFilters() {
    const q = (searchInput?.value || "").toLowerCase().trim();
    const tri = sortSelect?.value || "default";
    const dispo = dispoSelect?.value || "all";
    const modePrix = priceModeSelect?.value || "all";

    let visibleCount = 0;
    const visibleItems: HTMLElement[] = [];

    items.forEach((item) => {
      const cat = item.dataset.cat || "";
      const title = item.dataset.title || "";
      const summary = item.dataset.summary || "";
      const brand = item.dataset.brand || "";
      const availability = item.dataset.availability || "";
      const hasPrice = item.dataset.hasPrice === "true";

      let matches = true;

      // Filtre Catégorie
      if (activeCat !== "all" && cat !== activeCat) matches = false;

      // Filtre Texte
      if (q && !title.includes(q) && !summary.includes(q) && !brand.includes(q)) {
        matches = false;
      }

      // Filtre Disponibilité
      if (dispo !== "all" && availability !== dispo) matches = false;

      // Filtre Tarif
      if (modePrix === "with-price" && !hasPrice) matches = false;
      if (modePrix === "devis" && hasPrice) matches = false;

      if (matches) {
        item.style.display = "block";
        visibleCount++;
        visibleItems.push(item);
      } else {
        item.style.display = "none";
      }
    });

    // Tri
    if (grid && visibleItems.length > 0) {
      if (tri === "price-asc") {
        visibleItems.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
      } else if (tri === "price-desc") {
        visibleItems.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
      } else if (tri === "name-asc") {
        visibleItems.sort((a, b) => (a.dataset.title || "").localeCompare(b.dataset.title || ""));
      }
      visibleItems.forEach((el) => grid.appendChild(el));
    }

    // Mise à jour compteur & État vide
    if (countEl) countEl.textContent = String(visibleCount);
    if (emptyState) {
      if (visibleCount === 0) emptyState.removeAttribute("hidden");
      else emptyState.setAttribute("hidden", "");
    }

    // Synchronisation URL
    const url = new URL(window.location.href);
    if (q) url.searchParams.set("q", q); else url.searchParams.delete("q");
    if (activeCat !== "all") url.searchParams.set("cat", activeCat); else url.searchParams.delete("cat");
    if (tri !== "default") url.searchParams.set("tri", tri); else url.searchParams.delete("tri");
    if (dispo !== "all") url.searchParams.set("dispo", dispo); else url.searchParams.delete("dispo");
    if (modePrix !== "all") url.searchParams.set("prix", modePrix); else url.searchParams.delete("prix");

    window.history.replaceState({}, "", url.toString());
  }

  // Écouteurs d'événements
  searchInput?.addEventListener("input", updateFilters);
  sortSelect?.addEventListener("change", updateFilters);
  dispoSelect?.addEventListener("change", updateFilters);
  priceModeSelect?.addEventListener("change", updateFilters);

  catPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      catPills.forEach((p) => p.classList.remove("is-active"));
      pill.classList.add("is-active");
      activeCat = pill.dataset.cat || "all";
      updateFilters();
    });
  });

  // Appliquer au chargement
  updateFilters();
}

initBoutiqueFilters();
document.addEventListener("astro:page-load", initBoutiqueFilters);
</script>
